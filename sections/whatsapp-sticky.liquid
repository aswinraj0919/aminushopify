{% if section.settings.enable_whatsapp %}
  <a
    href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ section.settings.default_message | url_encode }}"
    class="whatsapp-sticky"
    target="_blank"
    aria-label="Chat on WhatsApp"
  >
    {% if section.settings.custom_icon != blank %}
      <img
        src="{{ section.settings.custom_icon | image_url }}"
        alt="WhatsApp"
        loading="lazy"
      >
    {% else %}
      <svg
        style="display:inline"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 30.667 30.667"
      >
        <path d="M30.667,14.939c0,8.25-6.74,14.938-15.056,14.938c-2.639,0-5.118-0.675-7.276-1.857L0,30.667l2.717-8.017
        c-1.37-2.25-2.159-4.892-2.159-7.712C0.559,6.688,7.297,0,15.613,0C23.928,0.002,30.667,6.689,30.667,14.939z
        M15.61,2.382c-6.979,0-12.656,5.634-12.656,12.56c0,2.748,0.896,5.292,2.411,7.362l-1.58,4.663l4.862-1.545
        c2,1.312,4.393,2.076,6.963,2.076c6.979,0,12.658-5.633,12.658-12.559C28.27,8.016,22.59,2.382,15.61,2.382z
        M23.214,18.38c-0.094-0.151-0.34-0.243-0.708-0.427c-0.367-0.184-2.184-1.069-2.521-1.189
        c-0.34-0.123-0.586-0.185-0.832,0.182c-0.243,0.367-0.951,1.191-1.168,1.437c-0.215,0.245-0.43,0.276-0.799,0.095
        c-0.369-0.186-1.559-0.57-2.969-1.817c-1.097-0.972-1.838-2.169-2.052-2.536c-0.217-0.366-0.022-0.564,0.161-0.746
        c0.165-0.165,0.369-0.428,0.554-0.643c0.185-0.213,0.246-0.364,0.369-0.609c0.121-0.245,0.06-0.458-0.031-0.643
        c-0.092-0.184-0.829-1.984-1.138-2.717c-0.307-0.732-0.614-0.611-0.83-0.611c-0.215,0-0.461-0.03-0.707-0.03
        S9.897,8.215,9.56,8.582s-1.291,1.252-1.291,3.054c0,1.804,1.321,3.543,1.506,3.787
        c0.186,0.243,2.554,4.062,6.305,5.528c3.753,1.465,3.753,0.976,4.429,0.914
        c0.678-0.062,2.184-0.885,2.49-1.739C23.307,19.268,23.307,18.533,23.214,18.38z"/>
      </svg>
    {% endif %}
  </a>
{% endif %}

<style>
  .whatsapp-sticky {
    position: fixed;
    z-index: 9999;
    bottom: {{ section.settings.bottom_spacing }}px;
    {% if section.settings.position == 'right' %}
      right: {{ section.settings.side_spacing }}px;
    {% else %}
      left: {{ section.settings.side_spacing }}px;
    {% endif %}
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.icon_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0,0,0,.25);
    transition: transform .3s ease, box-shadow .3s ease;
  }

  .whatsapp-sticky:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 28px rgba(0,0,0,.35);
  }

  .whatsapp-sticky svg {
    width: 60%;
    height: 60%;
  }

  .whatsapp-sticky img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
</style>

{% schema %}
{
  "name": "WhatsApp Sticky Button",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_whatsapp",
      "label": "Enable WhatsApp Button",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (with country code)",
      "default": "919999999999"
    },
    {
      "type": "text",
      "id": "default_message",
      "label": "Default Message",
      "default": "Hello, I want to know more!"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom WhatsApp Logo (optional)"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 40,
      "max": 90,
      "step": 2,
      "default": 56
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "right", "label": "Right Bottom" },
        { "value": "left", "label": "Left Bottom" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom Spacing",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "side_spacing",
      "label": "Side Spacing",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "WhatsApp Sticky Button"
    }
  ]
}
{% endschema %}
