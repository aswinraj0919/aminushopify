{% schema %}
{
  "name": "Copper Peptides Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "richtext",
      "id": "more_text",
      "label": "More Text"
    },
     {
      "type": "image_picker",
      "id": "video_poster_image",
      "label": "Video Poster Image"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
    }
  ]
}
{% endschema %}

<section class="bg-white sm:pt-12 pt-6 sm:pb-16 pb-8 h-border">
  <div class="lg:max-w-[1350px] max-w-[90%] m-auto">
    <div class="flex flex-col lg:flex-row justify-between bg-white">
      <!-- Text Section -->
      <div class="lg:max-w-[700px]">
        <!-- Dynamic Title -->
        <h2 class="sm:text-[44px] text-[32px] leading-[45px] font-[600] mb-4">{{ section.settings.title }}</h2>

        <!-- Dynamic Description -->
        <p class="font-[400] sm:text-[20px] mb-1 text-[14px] sm:leading-[32px] leading-[19px] md:w-[697px] w-full">
          {{ section.settings.description }}
        </p>

        <!-- Dynamic "More Text" initially hidden -->
        <span
          id="more-text"
          class="hidden font-[400] sm:text-[20px] text-[14px] sm:leading-[32px] leading-[19px]"
        >
          {{ section.settings.more_text }}
        </span>

        <!-- Read More / Less Buttons -->
        <button
          id="morebtn"
          class="sm:mt-0 font-[600] sm:text-[20px] text-[14px] sm:leading-[32px] leading-[19px] text-[#0066CB] focus:outline-none border-none hover:bg-transparent focus:bg-transparent"
          onclick="More()"
        >
          Read More
        </button>
        <button
          id="lessbtn"
          class="hidden sm:mt-0 font-[600] sm:text-[20px] text-[14px] sm:leading-[32px] leading-[19px] text-[#0066CB] focus:outline-none border-none hover:bg-transparent focus:bg-transparent"
          onclick="Less()"
        >
          Read Less
        </button>
      </div>

      <div class="custom-video__container_works sm:m-[1rem] cursor-pointer mx-auto">
        <div id="video-wrapper_works" class="relative mx-auto">
          <img
            src="{{section.settings.video_poster_image | image_url }}"
            alt="Video Poster"
            id="video-poster"
            class="w-[500px] h-[360px] mx-auto  object-cover"
          >
          <button
            data-modal-target="custom-modal_works"
            data-modal-toggle="custom-modal_works"
            class="custom-video__control_works hover:bg-transparent focus:outline-none"
            onclick="playVideoInModal()"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 50 50"
              width="140"
              height="140"
              fill="black"
              style="transform: scale(1.5);"
            >
              <path d="M20 15c0-1.1.9-2 2-2h0c.3 0 .5.1.7.3l14.5 10.5c.9.7.9 2.1 0 2.8L22.7 37.7c-.3.2-.5.3-.7.3h0c-1.1 0-2-.9-2-2V15z" fill="#000000"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div
    id="custom-modal_works"
    tabindex="-1"
    aria-hidden="true"
    class="hidden works_video_modal overflow-y-auto overflow-x-hidden fixed top-10 bottom-0 right-0 left-0 z-50 justify-center items-center w-full h-full"
  >
    <div class="relative p-4">
      <div class="relative bg-white rounded-[16px] shadow ">
        <!-- Modal header -->
        <div class="flex items-center justify-between  rounded-[16px] ">
          <button
            type="button"
            class="text-white bg-black  rounded-full w-8 h-8 ms-auto inline-flex justify-center items-center "
            data-modal-hide="custom-modal_works"
            onclick="stopVideoInModal()"
          >
            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
            </svg>
            <span class="sr-only">Close modal</span>
          </button>
        </div>
        <!-- Modal body -->
        <div class="py-2 px-2 space-y-4">
          <video
            class="custom-how_work_video_modal object-cover w-full  lg:w-[300px] lg:h-[500px] h-[400px]  rounded-[12px]"
            controls
            style="border: 0.2px solid black"
          >
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
    </div>
  </div>

  <!-- Styles for Play Button -->
  <style>
        .custom-video__control_works {
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          border-radius: 50%;
          padding: 1em;
          display: flex;
          justify-content: center;
          align-items: center;
          color: #000000;
          width: 60px;
          height: 60px;
          padding: 13px 0;
          border: 2px solid #000000;
        }
        <style>
      .h-border {
      border-bottom: 0.2px solid black;
    }


    @media (min-width: 640px) {
      .h-border {
        border-bottom: 0.5px solid black;

      }
    }</style>
  </style>

  <!-- JavaScript -->
  <script>
            function More() {
              // Show the hidden "More Text"
              document.getElementById("more-text").classList.remove("hidden");
              // Hide the "Read More" button
              document.getElementById("morebtn").classList.add("hidden");
              // Show the "Read Less" button
              document.getElementById("lessbtn").classList.remove("hidden");
            }

            function Less() {
              // Hide the "More Text"
              document.getElementById("more-text").classList.add("hidden");
              // Show the "Read More" button
              document.getElementById("morebtn").classList.remove("hidden");
              // Hide the "Read Less" button
              document.getElementById("lessbtn").classList.add("hidden");
            }

    function playVideoInModal() {
      const modaWorksl = document.getElementById('custom-modal_works');

      // Load the video into the video element
      const videoElement2 = modaWorksl.querySelector('video');
      videoElement2.src = '{{ section.settings.video_url }}';

      // Wait for the video to be ready and then play it
      videoElement2.load();  // Load the new source
      videoElement2.play();
      }


    function stopVideoInModal() {
      const modalWorks = document.getElementById('custom-modal_works');
      modalWorks.classList.add('hidden');

      // Stop the video and clear the video source
      const videoElement5 = modalWorks.querySelector('video');
      videoElement5.pause();
      videoElement5.src = '';  // Clear the source to stop the video completely
    }
  </script>
</section>
