  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const container = document.querySelector('.rotating-text');
      if (!container) return;

      const skeleton = container.querySelector('.text-skeleton');
      const words = Array.from(container.querySelectorAll('.word'));
      if (!words.length) return;

      let index = 0;
      let paused = false;
      let timeoutId = null;
      let gapTimeoutId = null;

      const visibleMs = 1200;
      const gapMs = 300;

      // Clear any existing intervals/timeouts first
      function cleanup() {
        if (timeoutId) clearTimeout(timeoutId);
        if (gapTimeoutId) clearTimeout(gapTimeoutId);
        timeoutId = null;
        gapTimeoutId = null;
      }

      // Initial setup - hide all words first
      words.forEach((word) => {
        word.classList.remove('active');
        word.style.opacity = '0';
        word.style.position = 'absolute';
        word.style.left = '0';
        word.style.top = '0';
        word.style.width = '100%';
      });

      // Show skeleton briefly, then start text
      setTimeout(() => {
        if (skeleton) skeleton.style.display = 'none';

        // Make sure no other rotations are running
        cleanup();

        // Show first word
        words[index].classList.add('active');
        words[index].style.opacity = '1';

        // Start rotation
        function rotate() {
          if (paused) return;

          // Hide current word
          words[index].classList.remove('active');
          words[index].style.opacity = '0';

          // Gap before showing next word
          gapTimeoutId = setTimeout(() => {
            index = (index + 1) % words.length;
            words[index].classList.add('active');
            words[index].style.opacity = '1';

            // Schedule next rotation
            timeoutId = setTimeout(rotate, visibleMs);
          }, gapMs);
        }

        // Start the cycle
        timeoutId = setTimeout(rotate, visibleMs);
      }, 700);

      // Pause on hover
      container.addEventListener('mouseenter', () => {
        paused = true;
      });

      // Resume on mouse leave
      container.addEventListener('mouseleave', () => {
        if (!paused) return;
        paused = false;

        // Restart the rotation from current word
        cleanup();
        timeoutId = setTimeout(() => {
          if (!paused) rotate();
        }, visibleMs);
      });

      // Clean up on page unload to prevent memory leaks
      window.addEventListener('beforeunload', cleanup);
    });
  </script>

  <script>  
        let isloadedPreORder = true;
        let clickedImage = 1;
        
        function updateMainMedia(mediaUrl, index, isVideoAvailable) {
    clickedImage = index; // Store the index (not index-1)
    
    const mainVideoSection = document.getElementById('main_video_section');
    const mainImageSection = document.getElementById('main_image_section');
    const videoElement = document.getElementById('mainVideoPlayer');
    const videoSource = videoElement.querySelector('source');
    const mainImage = document.getElementById('mainImage');

    if (isVideoAvailable) {
        mainImageSection.classList.add('hidden');
        mainVideoSection.classList.remove('hidden');
        
        if (videoSource) {
            videoSource.src = mediaUrl;
        } else {
            const newSource = document.createElement('source');
            newSource.src = mediaUrl;
            newSource.type = "video/mp4";
            videoElement.appendChild(newSource);
        }
        videoElement.load();
    } else {
        mainVideoSection.classList.add('hidden');
        mainImageSection.classList.remove('hidden');
        if (mainImage) {
            mainImage.src = mediaUrl;
        }
    }
}
        const mediaItems = [
        {% for media in product.media %}
          {% if media.media_type == 'image' %}
            {
              type: 'image',
              src: '{{ media.preview_image.src | image_url }}',
              index: {{ forloop.index0 }}
            },
          {% elsif media.media_type == 'video' %}
            {%- assign video_source = media.sources | where: 'format', 'mp4' | first -%}
            {
              type: 'video',
              src: '{{ video_source.url }}',
              thumbnail: '{{ media.preview_image.src | image_url }}',
              index: {{ forloop.index0 }}
            },
          {% endif %}
        {% endfor %}
      ];


    const carousel = document.getElementById('carousel');
    const thumbnails = document.getElementById('thumbnails');
    const prevBtn = document.getElementById('prev');
    const nextBtn = document.getElementById('next');
    let index = 0;

    function renderCarousel() {
      carousel.innerHTML = '';
      thumbnails.innerHTML = '';

      mediaItems.forEach((item, i) => {
          // Create slides
          let slide;
          if (item.type === 'image') {
              slide = `<div class="w-full flex-shrink-0">
                          <img src="${item.src}" class="object-contain m-auto w-full md:h-[70vh] h-[65vh]" alt="Media ${i+1}">
                      </div>`;
          } else if (item.type === 'video') {
              slide = `<div class="w-full flex-shrink-0">
                      <video muted playsinline class="object-contain m-auto w-full md:h-[70vh] h-[65vh]" controls autoplay muted>
                        <source src="${item.src}" type="video/mp4">
                        Your browser does not support the video tag.
                      </video>
                      </div>`;
          }
          carousel.innerHTML += slide;

          // Create thumbnails
          let thumb;
          if (item.type === 'image') {
              thumb = `<img src="${item.src}" class="thumb w-12 h-12 object-cover cursor-pointer border-2 ${i === 0 ? 'border-black' : 'border-red'}  border-gray-400 hover:border-gray-800" data-index="${i}">`;
          } else if (item.type === 'video') {
              thumb = `
                  <div class="relative thumb-wrapper cursor-pointer border-2 ${i === 0 ? 'border-black' : 'border-gray-400'} hover:border-gray-800" data-index="${i}">
                  <img src="${item.thumbnail}" class="w-16 h-12 object-cover">
                  <div class="custom-video__control_fourth custom-video__control3 absolute inset-0 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="20" height="20" fill="white">
                          <path d="M20 15c0-1.1.9-2 2-2h0c.3 0 .5.1.7.3l14.5 10.5c.9.7.9 2.1 0 2.8L22.7 37.7c-.3.2-.5.3-.7.3h0c-1.1 0-2-.9-2-2V15z" fill="#000000" />
                      </svg>
                  </div>
                  </div>
                 `;
          }
          thumbnails.innerHTML += thumb;
      });

      addThumbnailClickEvents();
      updateCarousel();
  }

    function updateCarousel() {
        const offset = -index * 100;
        carousel.style.transform = `translateX(${offset}%)`;

        document.querySelectorAll('.thumb').forEach((thumb, i) => {
            thumb.classList.toggle('border-gray-800', i === index);
            thumb.classList.toggle('border-gray-400', i !== index);
        });
    }


  function addThumbnailClickEvents() {
    document.querySelectorAll('.thumb-wrapper, .thumb').forEach(thumb => {
        thumb.addEventListener('click', (event) => {
            let target = event.target;
            
            // Ensure we get the correct `data-index`, whether clicking on the div, img, or svg inside the thumbnail
            while (!target.dataset.index && target.parentElement) {
                target = target.parentElement;
            }

            index = parseInt(target.getAttribute('data-index'));
            updateCarousel();
        });
    });
   }

    function mainImage(indexPhone) {
    if (indexPhone === undefined) {
        index = clickedImage; // Directly use clickedImage (not minus 1)
    } else {
        index = indexPhone;
    }
    
    updateCarousel();
    document.getElementById('popup-modal').classList.remove('hidden');
}

      prevBtn.addEventListener('click', () => {
            index = (index - 1 + mediaItems.length) % mediaItems.length;
            updateCarousel();
        });

        nextBtn.addEventListener('click', () => {
            index = (index + 1) % mediaItems.length;
            updateCarousel();
        });

      // Initialize the carousel
      renderCarousel(); 
    
    document.addEventListener('DOMContentLoaded', function() {
    const playButton = document.querySelector('.custom-video_carousel_control');
    const video = document.querySelector('.custom-video_carousel_video');
    const image = document.querySelector('.custom-video_carousel_image');
    
