        // Delegate click so it works immediately
        document.addEventListener('click', function (e) {
          // Close button
          if (e.target.closest('[data-modal-hide="popup-modal"]')) {
            closeModal();
          }

          // Click outside modal content
          if (e.target.id === 'popup-modal') {
            closeModal();
          }
        });
      })();
    </script>

