{% schema %}
{
  "name": "Information Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Why You Need This Section Settings"
    },
    {
      "type": "image_picker",
      "id": "application_video_poster_image",
      "label": "Video Poster Image",
      "info": "Recommended size: 350x350px"
    },
    {
      "type": "text",
      "id": "application_video_url",
      "label": "Video URL",
      "info": "Add direct MP4 video URL"
    },
    {
      "type": "textarea",
      "id": "why_you_need_video_des",
      "label": "Video Description",
      "default": "Watch how this product transforms your routine."
    },
    {
      "type": "header",
      "content": "How to Use Section Settings"
    },
    {
      "type": "text",
      "id": "carousel_title",
      "label": "Default Carousel Title",
      "default": "How to Use Our Product"
    },
    {
      "type": "richtext",
      "id": "carousel_description",
      "label": "Default Carousel Description",
      "default": "<p>Follow these <strong>simple steps</strong> to get the best results.</p>"
    }
  ],
  "blocks": [
    {
      "type": "product_details",
      "name": "Product Detail Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Detail Title",
          "default": "Product Specification"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Detail Description",
          "default": "Detailed information about this product feature."
        }
      ]
    },
    {
      "type": "why_you_need_this",
      "name": "Why You Need This Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Key Benefit"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit Description",
          "default": "Explain why this benefit matters to the customer."
        }
      ]
    },
    {
      "type": "how_to_use",
      "name": "How to Use Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image",
          "info": "Recommended size: 300x300px for desktop, 240x280px for mobile"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Step Title",
          "default": "<p>Step 1</p>"
        },

        {
          "type": "richtext",
          "id": "description",
          "label": "Step Description",
          "default": "<p>Follow these <strong>simple steps</strong> to get the best results.</p>"
        }
      ]
    },
    {
      "type": "pro_tips",
      "name": "Pro Tip",
      "settings": [
        {
          "type": "image_picker",
          "id": "pro_tips_image",
          "label": "Tip Icon/Image",
          "info": "Recommended size: 60x60px"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Tip Description",
          "default": "Share a professional tip or trick for better results."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Information Accordion",
      "blocks": [
        {
          "type": "product_details",
          "settings": {
            "title": "Material & Quality",
            "description": "Made from premium materials that ensure durability and comfort."
          }
        },
        {
          "type": "product_details",
          "settings": {
            "title": "Care Instructions",
            "description": "Easy to clean and maintain. Follow simple care instructions for long-lasting use."
          }
        },
        {
          "type": "why_you_need_this",
          "settings": {
            "title": "Saves Time & Effort",
            "description": "Our product streamlines your daily routine, saving you valuable time and effort."
          }
        },
        {
          "type": "why_you_need_this",
          "settings": {
            "title": "Enhances Results",
            "description": "Experience significantly better outcomes compared to traditional methods."
          }
        },
       
        {
          "type": "pro_tips",
          "settings": {
            "description": "For best results, use the product consistently as part of your daily routine."
          }
        },
        {
          "type": "pro_tips",
          "settings": {
            "description": "Store in a cool, dry place away from direct sunlight to maintain product quality."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<!-- Desktop Version -->
<section class="product-accordion-desktop">
  <div class="product-accordion-desktop__container">
    <div class="product-accordion-desktop__grid">
      <!-- Left column for accordion titles -->
      <div class="product-accordion-desktop__nav">
        <button
          class="product-accordion-desktop__nav-button product-accordion-desktop__nav-button--active"
          onclick="showContent(0)"
        >
          <span class="product-accordion-desktop__nav-icon">-</span>
          <div class="product-accordion-desktop__nav-text">Product Details</div>
        </button>
        <button class="product-accordion-desktop__nav-button" onclick="showContent(1)">
          <span class="product-accordion-desktop__nav-icon">+</span>
          <span class="product-accordion-desktop__nav-text">Why you need this</span>
        </button>
        <button class="product-accordion-desktop__nav-button" onclick="showContent(2)">
          <span class="product-accordion-desktop__nav-icon">+</span>
          <span class="product-accordion-desktop__nav-text">How to Use</span>
        </button>
        <button class="product-accordion-desktop__nav-button" onclick="showContent(3)">
          <span class="product-accordion-desktop__nav-icon">+</span>
          <span class="product-accordion-desktop__nav-text">Pro tips</span>
        </button>
      </div>

      <!-- Right column for content display -->
      <div class="product-accordion-desktop__content">
        <!-- Product Details Content -->
        <div id="content-0" class="product-accordion-desktop__content-pane">
          {% for block in section.blocks %}
            {% if block.type == 'product_details' %}
              <button class="product-accordion-desktop__sub-accordion">{{ block.settings.title }}</button>
              <div class="product-accordion-desktop__sub-panel">
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Why You Need This Content -->
        <div
          id="content-1"
          class="product-accordion-desktop__content-pane product-accordion-desktop__content-pane--hidden"
        >
          <div class="product-accordion-desktop__video-section">
            <div id="video-section-1" class="product-accordion-desktop__video-container">
              <div id="video-content-1" class="product-accordion-desktop__video-content">
                {% if section.settings.application_video_poster_image %}
                  <img
                    alt="Video Poster"
                    class="product-accordion-desktop__video-poster"
                    loading="lazy"
                    src="{{ section.settings.application_video_poster_image | img_url: 'master' }}"
                  >
                {% else %}
                  <div class="product-accordion-desktop__video-placeholder">
                    <span>Video Thumbnail</span>
                  </div>
                {% endif %}
                <div id="video-control-1" class="product-accordion-desktop__video-control" onclick="showDesktopVideo()">
                  <a class="product-accordion-desktop__video-play" aria-label="Play video">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="32"
                      height="32"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="white"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <polygon points="10 8 16 12 10 16 10 8"></polygon>
                    </svg>
                  </a>
                </div>
              </div>
              <div id="video-wrapper-1" class="product-accordion-desktop__video-wrapper">
                {% if section.settings.application_video_url %}
                  <video id="video-iframe-1" class="product-accordion-desktop__video-element" controls>
                    <source src="{{ section.settings.application_video_url }}" type="video/mp4">
                    Your browser does not support the video tag.
                  </video>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="product-accordion-desktop__text-content">
            {% if section.settings.why_you_need_video_des %}
              <p class="product-accordion-desktop__video-description">
                {{ section.settings.why_you_need_video_des }}
              </p>
            {% endif %}
            {% for block in section.blocks %}
              {% if block.type == 'why_you_need_this' %}
                <div class="product-accordion-desktop__text-block">
                  {% if block.settings.title %}
                    <p class="product-accordion-desktop__text-title">{{ block.settings.title }}</p>
                  {% endif %}
                  {% if block.settings.description %}
                    <p class="product-accordion-desktop__text-description">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- How to Use Content -->
        <div
          id="content-2"
          class="product-accordion-desktop__content-pane product-accordion-desktop__content-pane--hidden"
        >
          <div class="product-accordion-desktop__carousel-section">
            <div class="product-accordion-desktop__carousel-container">
              {% assign how_to_use_blocks = section.blocks | where: 'type', 'how_to_use' %}
              {% if how_to_use_blocks.size > 0 %}
                <div class="product-accordion-desktop__carousel">
                  {% for block in how_to_use_blocks %}
                    <div class="product-accordion-desktop__carousel-slide">
                      <div
                        class="product-accordion-desktop__carousel-item"
                        data-title="{{ block.settings.title | escape }}"
                        data-description="{{ block.settings.description }}"
                      >
                        {% if block.settings.image %}
                          <img
                            src="{{ block.settings.image | image_url: width: 300, height: 300, crop: 'center' }}"
                            alt="{{ block.settings.title | strip_html | escape }}"
                            class="product-accordion-desktop__carousel-image"
                            loading="lazy"
                          >
                        {% else %}
                          <div class="product-accordion-desktop__carousel-placeholder">
                            <span>Image {{ forloop.index }}</span>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>

                {% if how_to_use_blocks.size > 1 %}
                  <button
                    id="carousel-prev-accor"
                    class="product-accordion-desktop__carousel-button product-accordion-desktop__carousel-button--prev"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      stroke="currentColor"
                    >
                      <path d="M15.75 19.5L8.25 12l7.5-7.5"/>
                    </svg>
                  </button>

                  <button
                    id="carousel-next-accor"
                    class="product-accordion-desktop__carousel-button product-accordion-desktop__carousel-button--next"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      stroke="currentColor"
                    >
                      <path d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                    </svg>
                  </button>
                {% endif %}
              {% else %}
                <div class="product-accordion-desktop__carousel-empty">
                  <p>No images added for How to Use section</p>
                </div>
              {% endif %}
            </div>
          </div>

          <div class="product-accordion-desktop__carousel-text">
            <div id="defaultText">
              {% if section.settings.carousel_title %}
                <div class="product-accordion-desktop__carousel-main-title">{{ section.settings.carousel_title }}</div>
              {% endif %}
              {% if section.settings.carousel_description %}
                <div class="product-accordion-desktop__carousel-main-description">
                  {{ section.settings.carousel_description }}
                </div>
              {% endif %}
            </div>
            <div id="carousel-title" class="product-accordion-desktop__dynamic-content"></div>
          </div>
        </div>

        <!-- Pro Tips Content -->
        <div
          id="content-3"
          class="product-accordion-desktop__content-pane product-accordion-desktop__content-pane--hidden"
        >
          <div class="product-accordion-desktop__tips-section">
            <div class="product-accordion-desktop__tips-container">
              {% for block in section.blocks %}
                {% if block.type == 'pro_tips' %}
                  <div class="product-accordion-desktop__tip-item">
                    {% if block.settings.pro_tips_image %}
                      <div class="product-accordion-desktop__tip-icon">
                        <img
                          alt="Icon"
                          class="product-accordion-desktop__tip-image"
                          loading="lazy"
                          src="{{ block.settings.pro_tips_image | img_url: 'master' }}"
                        >
                      </div>
                    {% endif %}
                    {% if block.settings.description %}
                      <p class="product-accordion-desktop__tip-text">{{ block.settings.description }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

