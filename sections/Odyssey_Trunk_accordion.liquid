<!-- Add jQuery and Slick JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<script>
// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  console.log('DOM Loaded - Initializing accordion and carousels');
  
  // Initialize accordions
  initAccordion();
  initMobileAccordion();
  
  // Initialize carousels
  initCarousels();
  
  // Show first content on desktop
  showContent(0);
  
  // Show first content on mobile
  showContentMobile(0);
});

// Desktop Accordion Functions
function showContent(index) {
  console.log('Showing content for index:', index);
  
  // Hide all content panes
  document.querySelectorAll('.product-accordion-desktop__content-pane').forEach(content => {
    content.classList.add('product-accordion-desktop__content-pane--hidden');
  });
  
  // Reset all navigation buttons
  document.querySelectorAll('.product-accordion-desktop__nav-button').forEach((button, idx) => {
    const icon = button.querySelector('.product-accordion-desktop__nav-icon');
    if (idx === index) {
      button.classList.remove('product-accordion-desktop__nav-button--inactive');
      button.classList.add('product-accordion-desktop__nav-button--active');
      icon.textContent = '-';
    } else {
      button.classList.remove('product-accordion-desktop__nav-button--active');
      button.classList.add('product-accordion-desktop__nav-button--inactive');
      icon.textContent = '+';
    }
  });
  
  // Show selected content
  const content = document.getElementById(`content-${index}`);
  if (content) {
    content.classList.remove('product-accordion-desktop__content-pane--hidden');
    
    // If showing carousel content, refresh slick
    if (index === 2) {
      setTimeout(() => {
        if ($('.product-accordion-desktop__carousel').hasClass('slick-initialized')) {
          $('.product-accordion-desktop__carousel').slick('refresh');
        }
      }, 100);
    }
  }
}

// Mobile Accordion Functions
function showContentMobile(index) {
  const content = document.getElementById(`mobile-content-${index}`);
  const header = document.querySelectorAll('.product-accordion-mobile__header')[index];
  const icon = header.querySelector('.product-accordion-mobile__header-icon');
  
  if (content.classList.contains('product-accordion-mobile__content--hidden')) {
    // Hide all other contents
    document.querySelectorAll('.product-accordion-mobile__content').forEach(content => {
      content.classList.add('product-accordion-mobile__content--hidden');
    });
    
    // Reset all other headers
    document.querySelectorAll('.product-accordion-mobile__header').forEach((h, idx) => {
      const ic = h.querySelector('.product-accordion-mobile__header-icon');
      if (idx !== index) {
        h.classList.remove('product-accordion-mobile__header--active');
        h.classList.add('product-accordion-mobile__header--inactive');
        ic.textContent = '+';
      }
    });
    
    // Show current content
    content.classList.remove('product-accordion-mobile__content--hidden');
    header.classList.remove('product-accordion-mobile__header--inactive');
    header.classList.add('product-accordion-mobile__header--active');
    icon.textContent = '-';
    
    // If showing carousel content, refresh slick
    if (index === 2) {
      setTimeout(() => {
        if ($('.product-accordion-mobile__carousel').hasClass('slick-initialized')) {
          $('.product-accordion-mobile__carousel').slick('refresh');
        }
      }, 100);
    }
    
    // Scroll to header
    setTimeout(() => {
      header.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 300);
  } else {
    content.classList.add('product-accordion-mobile__content--hidden');
    header.classList.remove('product-accordion-mobile__header--active');
    header.classList.add('product-accordion-mobile__header--inactive');
    icon.textContent = '+';
  }
}

// Video Functions
function showDesktopVideo() {
  const videoWrapper = document.getElementById('video-wrapper-1');
  const videoContent = document.getElementById('video-content-1');
  const videoIframe = document.getElementById('video-iframe-1');
  
  if (videoWrapper && videoIframe) {
    videoWrapper.style.display = 'block';
    videoContent.style.display = 'none';
    videoIframe.play().catch(e => console.log('Video play failed:', e));
  }
}

function showUniqueVideo() {
  const videoWrapper = document.getElementById('unique-video-wrapper-1');
  const videoContent = document.getElementById('unique-video-content-1');
  const videoIframe = document.getElementById('unique-video-iframe-1');
  
  if (videoWrapper && videoIframe) {
    videoWrapper.style.display = 'block';
    videoContent.style.display = 'none';
    videoIframe.play().catch(e => console.log('Video play failed:', e));
  }
}

// Carousel Functions
function initCarousels() {
  console.log('Initializing carousels...');
  
  // Desktop Carousel
  if ($('.product-accordion-desktop__carousel').length && $('.product-accordion-desktop__carousel').children().length > 0) {
    console.log('Initializing desktop carousel');
    
    $('.product-accordion-desktop__carousel').slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      arrows: false,
      dots: false,
      infinite: false,
      speed: 300,
      adaptiveHeight: true,
      responsive: [
        {
          breakpoint: 768,
          settings: {
            arrows: false
          }
        }
      ]
    });
    
    // Arrow event handlers
    $('#carousel-prev-accor').off('click').on('click', function() {
      console.log('Desktop prev clicked');
      $('.product-accordion-desktop__carousel').slick('slickPrev');
      updateCarouselContent('desktop');
    });
    
    $('#carousel-next-accor').off('click').on('click', function() {
      console.log('Desktop next clicked');
      $('.product-accordion-desktop__carousel').slick('slickNext');
      updateCarouselContent('desktop');
    });
    
    // Slide change event
    $('.product-accordion-desktop__carousel').on('afterChange', function(event, slick, currentSlide) {
      console.log('Desktop slide changed to:', currentSlide);
      updateCarouselContent('desktop');
    });
  }
  
  // Mobile Carousel
  if ($('.product-accordion-mobile__carousel').length && $('.product-accordion-mobile__carousel').children().length > 0) {
    console.log('Initializing mobile carousel');
    
    $('.product-accordion-mobile__carousel').slick({
      slidesToShow: 1,
      slidesToScroll: 1,
      arrows: false,
      dots: false,
      infinite: false,
      speed: 300,
      adaptiveHeight: true
    });
    
    // Arrow event handlers
    $('#carousel-prev-accor-2').off('click').on('click', function() {
      console.log('Mobile prev clicked');
      $('.product-accordion-mobile__carousel').slick('slickPrev');
      updateCarouselContent('mobile');
    });
    
    $('#carousel-next-accor-2').off('click').on('click', function() {
      console.log('Mobile next clicked');
      $('.product-accordion-mobile__carousel').slick('slickNext');
      updateCarouselContent('mobile');
    });
    
    // Slide change event
    $('.product-accordion-mobile__carousel').on('afterChange', function(event, slick, currentSlide) {
      console.log('Mobile slide changed to:', currentSlide);
      updateCarouselContent('mobile');
    });
  }
}

function updateCarouselContent(type) {
  const isMobile = type === 'mobile';

  {% comment %} console.log("lakjskldjkc ===>>", type); {% endcomment %}

  const carousel = isMobile ? $('.product-accordion-mobile__carousel') : $('.product-accordion-desktop__carousel');
  const currentSlide = carousel.slick('slickCurrentSlide');
  const slideElement = carousel.find('.slick-slide').eq(currentSlide);
  {% comment %} const carouselItem = slideElement.find('.product-accordion-desktop__carousel-item') || 
                      slideElement.find('.product-accordion-mobile__carousel-item'); {% endcomment %}

  const carouselItem = slideElement.find(
    isMobile
      ? '.product-accordion-mobile__carousel-item'
      : '.product-accordion-desktop__carousel-item'
  );
  
  {% comment %} console.log('Updating carousel content for', type, 'slide:', currentSlide, "carousel ===>>", carousel, " carouselItem ====>>>", carouselItem); {% endcomment %}
  
  if (carouselItem.length) {
    const title = carouselItem.data('title');
    const description = carouselItem.data('description');
    
    console.log('Found carousel item data:', { title, description });
    
    if (title || description) {
      const titleElementId = isMobile ? 'carousel-title-1' : 'carousel-title';
      const defaultTextId = isMobile ? 'defaultText-1' : 'defaultText';
      
      const titleElement = document.getElementById(titleElementId);
      const defaultText = document.getElementById(defaultTextId);
      
      if (titleElement && defaultText) {
        let html = '';
        if (title) {
          const titleClass = isMobile ? 'product-accordion-mobile__carousel-main-title' : 'product-accordion-desktop__carousel-main-title';
          html += `<p class="${titleClass}">${title}</p>`;
        }
        if (description) {
          const descClass = isMobile ? 'product-accordion-mobile__carousel-main-description' : 'product-accordion-desktop__carousel-main-description';
          html += `<p class="${descClass}">${description}</p>`;
        }
        
        titleElement.innerHTML = html;
        titleElement.classList.remove('product-accordion-desktop__dynamic-content');
        titleElement.classList.remove('product-accordion-mobile__dynamic-content');
        defaultText.style.display = 'none';
      }
    }
  }
}

// Accordion Toggle Functions
function initAccordion() {
  console.log('Initializing desktop accordion');

  const accordionButtons = document.querySelectorAll(
    '.product-accordion-desktop__sub-accordion'
  );

  accordionButtons.forEach(button => {
    const panel = button.nextElementSibling;

    /* 🔥 DEFAULT OPEN */
    button.classList.add(
      'product-accordion-desktop__sub-accordion--active'
    );
    panel.classList.add('show');

    /* Click toggle */
    button.addEventListener('click', function () {
      this.classList.toggle(
        'product-accordion-desktop__sub-accordion--active'
      );
      panel.classList.toggle('show');
    });
  });
}


function initMobileAccordion() {
  console.log('Initializing mobile accordion');

  const accordionButtons = document.querySelectorAll(
    '.product-accordion-mobile__sub-accordion'
  );

  accordionButtons.forEach(button => {
    const panel = button.nextElementSibling;

    /* 🔥 DEFAULT OPEN */
    button.classList.add(
      'product-accordion-mobile__sub-accordion--active'
    );
    panel.classList.add('show');

    /* Click toggle */
    button.addEventListener('click', function () {
      this.classList.toggle(
        'product-accordion-mobile__sub-accordion--active'
      );
      panel.classList.toggle('show');
    });
  });
}


// Handle window resize
window.addEventListener('resize', function() {
  // Refresh carousels on resize
  if ($('.product-accordion-desktop__carousel').hasClass('slick-initialized')) {
    $('.product-accordion-desktop__carousel').slick('refresh');
  }
  if ($('.product-accordion-mobile__carousel').hasClass('slick-initialized')) {
    $('.product-accordion-mobile__carousel').slick('refresh');
  }
});

