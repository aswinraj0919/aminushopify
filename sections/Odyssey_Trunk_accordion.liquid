<style>
  /* Reset and Base Styles */
  .product-accordion-desktop,
  .product-accordion-mobile {
    box-sizing: border-box;
  }

  .product-accordion-desktop *,
  .product-accordion-mobile * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Hide mobile on desktop and desktop on mobile */
  @media (min-width: 769px) {
    .product-accordion-mobile {
      display: none !important;
    }
  }

  @media (max-width: 768px) {
    .product-accordion-desktop {
      display: none !important;
    }
  }

  /* Desktop Version Styles */
  .product-accordion-desktop {
    border-top: 0.5px solid #000000;
    background-color: white;
  }

  .product-accordion-desktop__container {
    max-width: 1350px;
    width: 90%;
    margin: 0 auto;
    padding: 48px 0;
  }

  .product-accordion-desktop__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 96px;
    align-items: start;
    background-color: white;
    overflow: hidden;
  }

  /* Desktop Navigation */
  .product-accordion-desktop__nav {
    display: flex;
    flex-direction: column;
  }

  .product-accordion-desktop__nav-button {
    padding: 8px 20px;
    margin-bottom: 20px;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    border: none;
    background-color: #F9EBDA;
    transition: all 0.3s ease;
  }

  .product-accordion-desktop__nav-button:hover {
    background-color: #FFFFFF;
  }

  .product-accordion-desktop__nav-button--active {
    background-color: #FFFFFF;
  }

  .product-accordion-desktop__nav-button--active .product-accordion-desktop__nav-icon {
    color: #000;
  }

  .product-accordion-desktop__nav-icon {
    margin-right: 16px;
    font-size: 40px;
    font-weight: 100;
    color: #000;
  }

  .product-accordion-desktop__nav-text {
    font-size: 40px;
    font-weight: 600;
    color: #000;
  }

  /* Desktop Content */
  .product-accordion-desktop__content {
    width: 100%;
  }

  .product-accordion-desktop__content-pane {
    display: block;
  }

  .product-accordion-desktop__content-pane--hidden {
    display: none;
  }

  /* Desktop Sub Accordion */
  .product-accordion-desktop__sub-accordion {
    background-color: #fff;
    color: #000000;
    cursor: pointer;
    width: 100%;
    border: none;
    text-align: left;
    outline: none;
    padding: 16px 0;
    font-size: 24px;
    font-weight: 500;
    transition: 0.4s;
  }

  .product-accordion-desktop__sub-accordion:hover {
    background-color: #f9f9f9;
  }

  .product-accordion-desktop__sub-panel {
    display: none;
    padding-bottom: 20px;
    border-bottom: 0.5px solid #000000;
  }

  .product-accordion-desktop__sub-panel.show {
    display: block;
  }

  .product-accordion-desktop__sub-panel p {
    font-size: 20px;
    font-weight: 300;
    margin: 0;
  }

  /* Desktop Video Styles */
