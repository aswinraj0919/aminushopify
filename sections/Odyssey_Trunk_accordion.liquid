    .product-accordion-mobile__header--inactive {
      background-color: #F9EBDA;
    }
    
    .product-accordion-mobile__header--inactive:hover {
      background-color: #ffffff;
    }
    
    .product-accordion-desktop__sub-accordion--active {
      background-color: #f9f9f9;
    }
    
    .product-accordion-mobile__sub-accordion--active {
      background-color: #f9f9f9;
    }
  </style>
`);
