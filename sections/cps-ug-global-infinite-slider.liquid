<style>
.marquee {
  display: flex;
  width: fit-content;
  animation: marquee 40s linear infinite;
  padding:12px 0 !important;
}

.marquee-inner {
  display: flex;
  flex-shrink: 0;
}

@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.marquee-text {
  font-family: 'Poppins', sans-serif;
  font-weight: 300;
  line-height: 26px;
  text-align: center;
  font-size: 22px;
}

@media (min-width: 768px) {
  .marquee-text {
    font-size: 20px;
  }
}
</style>

