<section class="custom-border-works">
  <div class="desktop-accordion ug-container">
    <div class="grid-container">
      <!-- Left column for accordion titles -->
      <div class="accordion-titles">
        <button
          class="accordion-header active"
          onclick="showContent(0)"
        >
          <span class="icon">-</span>
          <div>What it Does</div>
        </button>
        <button
          class="accordion-header"
          style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
          onclick="showContent(1)"
        >
          <span class="icon">+</span>
          <span> How it Works</span>
        </button>
        <button
          class="accordion-header"
          style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
          onclick="showContent(2)"
        >
          <span class="icon">+</span>
          <span>How to Use</span>
        </button>
        <button
          class="accordion-header"
          style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
          onclick="showContent(3)"
        >
          <span class="icon">+</span>
          <span>Why You'll Love It </span>
        </button>
      </div>

      <!-- Right column for content display -->
      <div class="accordion-content-container">
        <div class="accordion-content active">
          <div class="content-wrapper">
            <div class="content-section">
              <div class="text-custom">
                <p class="text-[#000000]">
                  {{ product.metafields.custom.what_it_does_description }}
                </p>
              </div>
              <ul>
                {% for block in product.metafields.custom.what_it_does.value %}
                  <div class="flex flex-row justify-start items-start overflow-hidden mt-5">
                    <div class="mr-3 flex-shrink-0 w-[63px] h-[63px] sm:w-[50px] sm:h-[50px] xs:w-[40px] xs:h-[40px]">
                      <img
                        src="{{ block.what_it_does_icon | file_url }}"
                        alt="Icon"
                        class="w-full h-full object-contain"
                      >
                    </div>
                    <div class="text-custom">
                      <p class="w-[570px] max-w-full">
                        {{ block.what_it_does_icon_text }}
                      </p>
                    </div>
                  </div>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
        <div class="accordion-content">
          <div class="text-custom">
            <p>
              {{ product.metafields.custom.how_it_works_items | metafield_tag }}
            </p>
          </div>
        </div>

        <div class="accordion-content">
          <div class="video-section">
            <div id="video-section-1" class="custom-video__container">
              <div id="video-content-1" class="custom-video__content">
                <img
                  src="{{ product.metafields.custom.how_to_use_video_poster | file_url  }}"
                  alt="Video Poster"
                  class="custom-video__video"
                  style="border:1px solid black"
                >
                <!-- Centering and styling the play icon -->
                <div
                  id="video-control-1"
                  class="custom-video__control"
                  onclick="showDesktopVideo()"
                >
                  <a class="video-container__play" aria-label="Play video">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="32"
                      height="32"
                      viewBox="0 0 24 24"
                      fill="none"
                    >
                      <polygon points="10 8 16 12 10 16" fill="white"></polygon>
                    </svg>
                  </a>
                </div>
              </div>

              <div id="video-wrapper-1" class="video-wrapper">
                <video
                  id="video-iframe-1"
                  class="desktop-video"
                  controls
                  style="border:1px solid black"
                  preload="auto"
                >
                  <source src="{{ product.metafields.custom.how_to_use_video_url | file_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          </div>

          <div class="text-custom">
            <p>
              {{ product.metafields.custom.how_to_use_items | metafield_tag }}
            </p>
          </div>
        </div>

        <div class="accordion-content text-custom">
          <p>
            {{ product.metafields.custom.story_behind_items | metafield_tag }}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- phone format code -->
<section class="mobile-accordion">
  <div class="mobile-grid">
    <button
      class="mobile-accordion-header"
      style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
      onclick="showContentmobile(0)"
    >
      <span class="mobile-icon">+</span>
      <div>What It Does</div>
    </button>

    <div class="mobile-accordion-content">
      <div class="mobile-content-wrapper">
        <div class="mobile-content-section">
          <div class="mobile-text">
            <p>
              {{ product.metafields.custom.what_it_does_description }}
            </p>
          </div>
          <ul>
            {% for block in product.metafields.custom.what_it_does.value %}
              <div class="mobile-icon-text-row">
                <div class="mobile-icon-container">
                  <img
                    src="{{ block.what_it_does_icon | file_url }}"
                    alt="Icon"
                  >
                </div>
                <div class="mobile-text" style="width: 99%">
                  <p>
                    {{ block.what_it_does_icon_text }}
                  </p>
                </div>
              </div>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>

    <button
      class="mobile-accordion-header"
      style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
      onclick="showContentmobile(1)"
    >
      <span class="mobile-icon">+</span>
      <span> How it Works</span>
    </button>

    <div class="mobile-accordion-content">
      <div class="mobile-text">
        <p>
          {{ product.metafields.custom.how_it_works_items | metafield_tag }}
        </p>
      </div>
    </div>

    <button
      class="mobile-accordion-header key-ingredients-btn active"
      onclick="showContentmobile(2)"
    >
      <span class="mobile-icon">-</span>
      <span>Key Ingredients</span>
    </button>

    <div class="mobile-accordion-content key-ingredients-content active">
      <div class="carousel-container">
        <div class="key-ingredients-carousel">
          {% for block in product.metafields.custom.key_ingredients_carousel.value %}
            <div class="carousel-item">
              <img
                src="{{ block.key_ingredients_cover_image | file_url }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
                class="carousel-image"
              >
              <h3 class="w-[280px]">
                {{ block.key_ingredients_carousel_title }}
              </h3>
              <p class="w-[280px]">
                {{ block.key_ingredients_carousel_description }}
              </p>
            </div>
          {% endfor %}
        </div>

        <div class="mobile-text">
          <p>
            {{ product.metafields.custom.key_ingredients_mobile_free_of_text | metafield_tag }}
          </p>
        </div>
      </div>

      <div class="ingredient-button-container">
        <button
          class="popup-trigger text-white hover:text-black py-3 px-20 border-[1px] rounded-[4px] border-black sm:text-[20px] text-[14px] font-[500] leading-[19px] sm:w-fit w-full cursor-pointer"
          data-target="#popup-ingredients"
          style="
            --brand-black: {{ product.metafields.custom.brand_black_color | default: '#000000' }};
            --primary-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};
            background-color: var(--brand-black);
          "
          onmouseover="this.style.backgroundColor='var(--primary-color)'"
          onmouseout="this.style.backgroundColor='var(--brand-black)'"
        >
          Full Ingredient List
        </button>
      </div>
    </div>
    <div id="popup-ingredients" class="popup z-999">
      <div class="popup-content">
        <!-- Sticky Close Button -->
        <div class="sticky top-0 right-0 bg-white flex justify-end z-20">
          <button
            class="popup-close bg-black text-white w-[30px] h-[30px] flex items-center justify-center rounded-full hover:bg-gray-700 m-2"
            id="closeModal"
          >
            ✕
          </button>
        </div>
        <div class="popup-text px-6 py-3">
          {{ product.metafields.custom.key_ingredients_full_ingredient_list_text | metafield_tag }}
        </div>
      </div>
    </div>

    <button
      class="mobile-accordion-header"
      style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
      onclick="showContentmobile(3)"
    >
      <span class="mobile-icon">+</span>
      <span> How to use</span>
    </button>

    <div class="mobile-accordion-content">
      <div class="mobile-video-section">
        <div
          id="unique-video-section-1"
          class="mobile-custom-video__container"
        >
          <div id="unique-video-content-1" class="mobile-custom-video__content">
            <img
              src="{{ product.metafields.custom.how_to_use_video_poster | file_url }}"
              alt="Video Poster"
              class="mobile-custom-video__video"
              style="border: 1px solid black"
            >
            <!-- Centering and styling the play icon -->
            <div
              id="unique-video-control-1"
              class="mobile-custom-video__control"
              onclick="showUniqueVideo()"
            >
              <a class="video-container__play" aria-label="Play video">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <polygon points="10 8 16 12 10 16" fill="white"></polygon>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mobile-text">
        <p>
          {{ product.metafields.custom.how_to_use_items | metafield_tag }}
        </p>
      </div>
    </div>

    {% comment %} video model {% endcomment %}

    <div id="videoModal" class="video-modal">
      <div class="modal-video-container">
        <video
          playsinline
          webkit-playsinline
          id="modalVideo"
          controls
          muted
        >
          <source src="{{ product.metafields.custom.how_to_use_video_url | file_url }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
        <button
          onclick="closeVideoModal()"
          class="modal-video-close"
        >
          ✕
        </button>
      </div>
    </div>

    <button
      class="mobile-accordion-header"
      style="background-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};"
      onclick="showContentmobile(4)"
    >
      <span class="mobile-icon">+</span>
      <span>Why You'll Love It</span>
    </button>
    <div class="mobile-accordion-content">
      <div class="mobile-text">
        <p>{{ product.metafields.custom.story_behind_items | metafield_tag }}</p>
      </div>
    </div>
  </div>
</section>

