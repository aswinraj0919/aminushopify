<!-- Slick Slider CDN -->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css">
<script defer src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script async src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js" type="text/javascript"></script>

<script>
  // Initialize Slick Slider when document is ready
  document.addEventListener('DOMContentLoaded', function () {
    initializeSlickSlider();

    // Modal functionality
    const modal = document.getElementById('my-modal-ingredient');
    const modalToggle = document.querySelector('[data-modal-toggle="my-modal-ingredient"]');
    const modalHide = document.querySelector('[data-modal-hide="my-modal-ingredient"]');

    if (modalToggle) {
      modalToggle.addEventListener('click', function () {
        modal.classList.add('active');
      });
    }

    if (modalHide) {
      modalHide.addEventListener('click', function () {
        modal.classList.remove('active');
      });
    }

    // Close modal when clicking outside
    window.addEventListener('click', function (event) {
      if (event.target === modal) {
        modal.classList.remove('active');
      }
    });
  });

  function initializeSlickSlider() {
    const $slider = $('.key-ingredients-carousel');

    if ($slider.length && typeof $.fn.slick !== 'undefined') {
      // Destroy existing slick slider if any
      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }

      // Initialize new slick slider with custom arrows and dots
      $slider.slick({
        dots: true,
        arrows: true,
        infinite: true,
        speed: 400,
        slidesToShow: 1,
        slidesToScroll: 1,
        prevArrow: `
    <button type="button" class="slick-prev">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>`,
        nextArrow: `
    <button type="button" class="slick-next">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>`,
        {% comment %} appendDots: $slider.parent(), {% endcomment %}
        customPaging: function (slider, i) {
          return '<button type="button" class="slick-dot"></button>';
        },
        responsive: [
          {
            breakpoint: 1024,
            settings: {
              slidesToShow: 1,
              slidesToScroll: 1,
            },
          },
          {
            breakpoint: 600,
            settings: {
              slidesToShow: 1,
              slidesToScroll: 1,
            },
          },
        ],
      });

      console.log('Slick Slider initialized successfully');
    } else {
      console.error('Slick Slider not loaded properly');
    }
  }

  // पुराना resize event listener हटाएं और नया logic लागू करें
  document.addEventListener('DOMContentLoaded', function () {
    const color = '{{ product.metafields.custom.primary_brand_color | default: "#F9EBDA" }}';
    let isInitialLoad = true; // यह track करेगा कि पहली बार page load हुआ है

    function showContentmobile(index) {
      const headers = document.querySelectorAll('.mobile-accordion-header');
      const contents = document.querySelectorAll('.mobile-accordion-content');

      headers.forEach((header, idx) => {
        const icon = header.querySelector('.mobile-icon');
        const content = contents[idx];

        if (idx === index) {
          const isActive = header.classList.contains('active');

          if (isActive) {
            // यदि पहले से active है तो बंद करें
            header.classList.remove('active');
            header.style.backgroundColor = color;
            icon.textContent = '+';
            content.classList.remove('active');
          } else {
            // सभी अन्य टैब्स बंद करें
            headers.forEach((h, i) => {
              h.classList.remove('active');
              h.style.backgroundColor = color;
              const otherIcon = h.querySelector('.mobile-icon');
              if (otherIcon) otherIcon.textContent = '+';
              contents[i].classList.remove('active');
            });

            // क्लिक किए गए टैब को खोलें
            header.classList.add('active');
            header.style.backgroundColor = 'white';
            icon.textContent = '-';
            content.classList.add('active');

            // केवल Key Ingredients के लिए slick slider initialize करें
            if (idx === 2) {
              setTimeout(() => initializeSlickSlider(), 300);
            }

            // Smooth scroll into view
            {% comment %} header.scrollIntoView({ behavior: 'smooth', block: 'start' }); {% endcomment %}
             const yOffset = -75;
             const y = header.getBoundingClientRect().top + window.pageYOffset + yOffset;

window.scrollTo({
  top: y,
  behavior: 'smooth'
});

          }

          // अब initial load पूरा हो गया है
          if (isInitialLoad) {
            isInitialLoad = false;
          }
        }
      });
    }

    // ✅ मोबाइल पर पहली बार page load होने पर Key Ingredients खोलें
    function openKeyIngredientsOnInitialLoad() {
      if (window.innerWidth <= 640 && isInitialLoad) {
        const headers = document.querySelectorAll('.mobile-accordion-header');
        const contents = document.querySelectorAll('.mobile-accordion-content');
        const keyHeader = headers[2];
        const keyContent = contents[2];
        const icon = keyHeader?.querySelector('.mobile-icon');

        if (keyHeader && keyContent) {
          // सभी अन्य टैब्स बंद करें
          headers.forEach((h, i) => {
            h.classList.remove('active');
            h.style.backgroundColor = color;
            const otherIcon = h.querySelector('.mobile-icon');
            if (otherIcon) otherIcon.textContent = '+';
            contents[i].classList.remove('active');
          });

          // Key Ingredients खोलें
          keyHeader.classList.add('active');
          keyHeader.style.backgroundColor = 'white';
          keyContent.classList.add('active');
          if (icon) icon.textContent = '-';

          setTimeout(() => initializeSlickSlider(), 300);
        }

        isInitialLoad = false;
      }
    }

    // ✅ Page load होने पर केवल एक बार चलाएं
    openKeyIngredientsOnInitialLoad();

    // इसके बजाय, resize होने पर slick slider को reinitialize करें (यदि Key Ingredients खुला है)
    window.addEventListener('resize', function () {
      const keyHeader = document.querySelector('.mobile-accordion-header.key-ingredients-btn');
      if (keyHeader && keyHeader.classList.contains('active')) {
        setTimeout(() => initializeSlickSlider(), 100);
      }
    });

    // Global function expose करें
    window.showContentmobile = showContentmobile;
  });

  function showUniqueVideo() {
    const modal = document.getElementById('videoModal');
    const vid = document.getElementById('modalVideo');

    modal.classList.add('active');
    vid.currentTime = 0;

    const playPromise = vid.play();
    if (playPromise !== undefined) {
      playPromise.catch((error) => {
        console.log('Autoplay blocked:', error);
      });
    }
  }

  function closeVideoModal() {
    const modal = document.getElementById('videoModal');
    const vid = document.getElementById('modalVideo');

    vid.pause();
    modal.classList.remove('active');
  }

  function showContent(index) {
    const headers = document.querySelectorAll('.accordion-header');
    const contents = document.querySelectorAll('.accordion-content');
    const color = '{{ product.metafields.custom.primary_brand_color | default: "#F9EBDA" }}';

    headers.forEach((header, idx) => {
      const icon = header.querySelector('.icon');
      if (idx === index) {
        header.classList.toggle('active');
        if (header.classList.contains('active')) {
          header.style.backgroundColor = 'white';
          icon.textContent = '-';
        } else {
          header.style.backgroundColor = color;
          icon.textContent = '+';
        }
      } else {
        header.classList.remove('active');
        header.style.backgroundColor = color;
        icon.textContent = '+';
      }
    });

    contents.forEach((content, idx) => {
      if (idx === index && headers[index].classList.contains('active')) {
        content.classList.add('active');
      } else {
        content.classList.remove('active');
      }
    });
  }

  function showDesktopVideo() {
    const videoWrapper = document.getElementById('video-wrapper-1');
    const videoContent = document.getElementById('video-content-1');
    const videoElement = document.getElementById('video-iframe-1');

    if (videoWrapper && videoElement && videoContent) {
      videoContent.style.display = 'none';
      videoWrapper.style.display = 'block';

      // Unmute and play the video
      videoElement.muted = false;
      const playPromise = videoElement.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          console.log('Autoplay prevented — user interaction required.');
        });
      }
    }
  }

  $(document).ready(function () {
    /* -----------------------------
       POPUP LOGIC
    ----------------------------- */
    function openPopup(popup) {
      $(popup).css('display', 'flex'); // instant open
      $(popup)
        .off('click')
        .on('click', function (e) {
          if (e.target === this) {
            $(popup).hide(); // close when clicking outside
          }
        });
    }

    function closePopup(popup) {
      $(popup).hide(); // instant close
    }

    // Open popup on trigger click
    $('.popup-trigger').on('click', function () {
      const target = $(this).data('target');
      openPopup($(target));
    });

    // Close popup on ✕ click
    $(document).on('click', '.popup-close', function () {
      closePopup($(this).closest('.popup'));
    });
  });
</script>
