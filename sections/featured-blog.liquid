{% comment %}
  Section: Blog Posts Section - Mobile Slider
{% endcomment %}

<section class="homepage-blog tc-padding">
  <div class="ug-blog-container">
    <!-- Section Header with Heading and Subheading -->
    <div class="blog-header">
      {% if section.settings.title != blank %}
        <h2 class="blog-section-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="blog-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% assign blog = blogs[section.settings.blog] %}
    {% if blog.articles_count > 0 %}
      <!-- Desktop Grid -->
      <div class="blog-grid desktop-blog-grid">
        {% for article in blog.articles limit: section.settings.post_limit %}
          <div class="blog-card">
            <a href="{{ article.url }}" class="blog-image">
              {% if article.image %}
                <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.title }}" loading="lazy">
              {% endif %}
            </a>
            <div class="blog-content">
              <h3 class="blog-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              <p class="blog-excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
              <a href="{{ article.url }}" class="read-more-btn ug-btn-hover">Read More</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Mobile Slider -->
      <div class="blog-slider mobile-blog-slider">
        <div class="blog-slider-container">
          {% for article in blog.articles limit: section.settings.post_limit %}
            <div class="blog-slide">
              <div class="blog-card">
                <a href="{{ article.url }}" class="blog-image">
                  {% if article.image %}
                    <img src="{{ article.image | img_url: '600x' }}" alt="{{ article.title }}" loading="lazy">
                  {% endif %}
                </a>
                <div class="blog-content">
                  <h3 class="blog-title">
                    <a href="{{ article.url }}">{{ article.title }}</a>
                  </h3>
                  <p class="blog-excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
                  <a href="{{ article.url }}" class="read-more-btn">Read More</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- View All Button -->
      <div class="view-all-container">
        <a href="{{ blog.url }}" class="view-all-btn">View All →</a>
      </div>
    {% else %}
      <p>No blog posts found.</p>
    {% endif %}
  </div>
</section>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

    .homepage-blog {
      background: #fff;
      font-family: "Poppins", sans-serif;
    }

    .ug-blog-container {
    max-width: 1280px;
    margin: 0 auto;
    padding-top:40px !important;
    {% comment %} padding-bottom:40px!important; {% endcomment %}
  }
  @media (max-width: 768px) {
    .ug-blog-container {
      max-width: 100%;
      margin: 0 auto;
      padding-top: 30px !important;
          {% comment %} padding-bottom: 30px !important; {% endcomment %}
      padding-right: 16px !important;
      padding-left: 16px !important;
    }
  }

    /* Blog Header */
    .blog-header {
      text-align: left;
      margin-bottom: 40px;
    }

    .blog-section-title {
      font-family: "Poppins", sans-serif;
      font-size: 42px;
      font-weight: 600;
      margin-bottom: 15px;
      color: #000;
    }

    .blog-subheading {
      font-family: "Poppins", sans-serif;
      font-size: 18px;
      font-weight: 400;
      line-height: 30px;
      margin: 0;
    }

    /* Desktop Grid */
    .desktop-blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      justify-content: center;
    }

    .mobile-blog-slider {
      display: none;
    }

    .blog-card {
      border-radius: 4px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 100%;
      background: #fff;
      transition: all 0.3s ease;
      border: 0.5px solid #000000;
    }

    .blog-image {
      padding:0 !important;
      margin:0 !important;
       width: 100%;
      height: 400px;
    }

    .blog-image img {
      width: 100%;
      height: 400px;
      object-fit: cover;
      border-radius: 4px;
      padding:0;
      margin:0;
    }

    .blog-content {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      background: #F7F7F7;
      padding-top:10px;
    }

    .blog-title a {
      font-family: "Poppins", sans-serif;
      font-size: 18px;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 10px;
      display: block;
      text-align: left;
      line-height: 21px;
     padding: 2px 10px;

    }

    .blog-excerpt {
      font-family: "Poppins", sans-serif;
      font-size: 12px;
      font-weight:300;
      margin-bottom: 20px;
      flex-grow: 1;
      line-height: 20px;
      text-align: left;
     padding: 2px 10px;

    }

    .read-more-btn {
      font-family: "Poppins", sans-serif;
      font-size: 14px;
      font-weight: 600;
      display: block;
      text-align: center;
      color: #fff;
      background: #000;
      padding: 12px 0;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 4px;
      transition: all 0.3s ease;
      border: none;
    }
    /* View All Button */
    .view-all-container {
      text-align: center;
      padding-top:32px;
      padding-bottom:48px;
    }

    .view-all-btn {
      display: inline-block;
      {% comment %} padding: 12px 30px; {% endcomment %}
      color: #1D3EA0;
      text-decoration: underline;
      font-family: "Poppins", sans-serif;
      font-size: 20px;
      font-weight: 700;
      text-transform:uppercase;
    }

    /* Mobile Slider Styles */
    @media screen and (max-width: 768px) {
      .desktop-blog-grid {
        display: none;
      }

      .mobile-blog-slider {
        display: block;
        position: relative;
      }
      .blog-image{
        height:300px !important;
      }
      .blog-slider-container {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 16px;
        {% comment %} padding: 10px 0 20px; {% endcomment %}
        {% comment %} padding-left: 10px;
        padding-right: 10px; {% endcomment %}
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      .blog-slider-container::-webkit-scrollbar {
        display: none;
      }

      .blog-slide {
        flex: 0 0 65%;
        min-width: 65%;
        max-width: 65%;
        scroll-snap-align: start;
      }

      .blog-header {
        text-align: left;
        margin-bottom: 10px;
      }

      .blog-section-title {
        font-size: 36px;
        line-height: 42px;
        margin-bottom: 10px;
      }

      .blog-subheading {
        font-size: 16px;
      }

      .blog-image img {
        height: 300px;
      }

      .blog-content {
        padding: 15px;
      }

      .blog-title a {
        font-size: 16px;
        margin-top:5px;
        margin-bottom:0;
      }

      .blog-excerpt {
        font-size: 12px;
      }

      .read-more-btn {
        font-size: 14px;
        padding: 10px 0;
      }

      .view-all-container {
      text-align: center;
      padding-top:16px;
        padding-bottom:24px;
    }

      .view-all-btn {
        padding: 0;
        font-size: 15px;
      }
    }

    @media screen and (max-width: 480px) {
      .blog-section-title {
        font-size: 30px;
        line-height: 34px;
      }

      .blog-subheading {
        font-size: 15px;
      }

      .blog-slide {
        flex: 0 0 90%;
        min-width: 90%;
        max-width: 90%;
      }

      .blog-image img {
        height: 300px;
      }

      .blog-content {
        padding: 0;
      }

    }

    /* Small Mobile */
    @media screen and (max-width: 360px) {
      .blog-slide {
        flex: 0 0 92%;
        min-width: 92%;
        max-width: 92%;
      }

      .blog-section-title {
        font-size: 24px;
      }

      .blog-subheading {
        font-size: 14px;
      }

        {% comment %} .blog-card {
      border: none
    } {% endcomment %}
    }
</style>

{% schema %}
{
  "name": "Blog Posts",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "From Our Blog"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "want to know more?"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts to show",
      "min": 1,
      "max": 6,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Blog Posts",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
