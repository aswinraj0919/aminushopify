

<section class="chat-with-experts-section">
  <div class="page-width chat-with-experts-wrapper">
    <h2 class="chat-heading">Confused? Chat with our Skin Experts!</h2>

    <a href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" class="chat-button">
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

<style>
  .chat-with-experts-section {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border-top: 1px solid rgb(0, 0, 0);
    border-bottom: 1px solid rgb(0, 0, 0);
  }

  .chat-heading {
    font-size: 28px;
    font-weight: 600;
    color: #333;
    margin-bottom: 20px;
  }

  .chat-button {
    display: inline-block;
    background-color:rgb(0, 0, 0); /* WhatsApp green */
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    padding: 12px 30px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .chat-button:hover {
    background-color: #1ebc5b;
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .chat-heading {
      font-size: 22px;
    }
    .chat-button {
      font-size: 16px;
      padding: 10px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Chat with Skin Experts",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (with country code)",
      "default": "+919324752679"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Confused? Chat with our Skin Experts!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Chat with us"
    }
  ],
  "presets": [
    {
      "name": "Chat with Skin Experts"
    }
  ]
}
{% endschema %}
