<!-- Section: Icons -->
<section class="bg-[#0066CB] h-auto py-8">
  <div class="sm:max-w-[1200px] max-w-[80%] mx-auto sm:px-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 sm:gap-20 gap-6 text-white">
    {% for block in section.blocks %}
      <div class="flex flex-col items-center w-full">
        <div
            class=" rounded-full mb-1 h-[80px] w-[80px] md:h-[120px] md:w-[120px] flex items-center justify-center sm:p-0 p-6"
          style="border: 1px solid white"
        >
          <img
            src="{{ block.settings.icon_path | image_url }}"
            alt="{{ block.settings.icon_text }}"
              class=" sm:w-[70px] w-[40px] sm:h-[70px] h-[40px] object-contain"
           
          >
        </div>
        <p class="sm:font-semibold font-light text-center text-[14px] md:text-[20px]  mt-2 w-[120px]">
          {{ block.settings.icon_text }}
        </p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Icons Container",
  "settings": [],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Block",
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon Text",
          "default": "Icon Text"
        },
           {
          "type": "image_picker",
          "id": "icon_path",
          "label": "Image"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Icons Container",
      "category": "Custom"
    }
  ]
}
{% endschema %}
