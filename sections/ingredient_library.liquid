  <svg
    xmlns="http://www.w3.org/2000/svg"
    height="24"
    viewBox="0 96 960 960"
    width="24"
    fill="black"
  >
    <path d="M560 816 320 576l240-240 56 56-184 184 184 184-56 56Z" />
  </svg>
</div>

      <div class="p-4 md:p-5 text-center ">
