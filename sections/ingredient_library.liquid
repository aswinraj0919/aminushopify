</section>

<style>
    .library_btn_active {
      background: black !important;
      color: white !important;
    }
    @media (min-width: 768px) {
    #mobile-view-button {
      display: none;
    }
  }
    @media (max-width: 768px) {
    #show-more-button {
      display: none;
    }
  }
  /* Make the button sticky */
.sticky-back-button {
  position: sticky;
  top: 13px; 
  left: 7px; 
  /* z-index: 1000;  */
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border: 1px solid #ccc;
  border-radius: 8px;
  background-color: white; 
}



</style>

<script>
  function freezeBackground() {
    document.body.classList.add('overflow-hidden');
  }

  function unfreezeBackground() {
    document.body.classList.remove('overflow-hidden');
  }

  
function closeModal(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) {
    modal.classList.add('hidden'); // Hide the modal
  } else {
    console.error(`Modal with ID ${modalId} not found`);
        modal.offsetHeight; // Trigger reflow to ensure state update
  }
}

  document.addEventListener('keydown', function (event) {
  if (event.key === 'Escape') {
    closeModal('category-view');
  }
    unfreezeBackground();

});


  
function showIngredients(letter, button) {
  const ingredientList = document.getElementById("ingredient-list");
 const showMoreButton = document.getElementById("show-more-button");
  const showLessButton = document.getElementById("show-less-button");

  //phone
  const mobileViewButton = document.getElementById("mobile-view-button");
const categoryView = document.getElementById("category-view");
const mobileIngredientList = document.getElementById("mobile-ingredient-list");
    
  const ingredients = ingredientData[letter] || [];
  const initialLimit = 4; // Number of ingredients to show initially
  let isShowingAll = false; // Track if all ingredients are shown

  // Function to render ingredients based on the limit
  function renderIngredients(limit, container) {
    container.innerHTML = ""; // Clear content

    ingredients.slice(0, limit).forEach(ingredient => {
      const item = document.createElement("div");
      item.className = "ingredient-item flex flex-col items-center text-center cursor-pointer";
      item.onclick = () => openModal(ingredient); // Add click handler

      item.innerHTML = `
        <div class="mb-4 mx-auto sm:h-[200px] h-[100px] sm:w-[200px] w-[100px]">
          <img src="${ingredient.img}" alt="${ingredient.name}" class="w-full h-full object-cover rounded-full" style="border:0.2px solid black;">
        </div>
        <h3 class="sm:text-[24px] text-[14px] font-light sm:leading-[30px] leading-[20px] uppercase">${ingredient.name}</h3>`;
      container.appendChild(item);
    });
  }
 // Function to toggle ingredients and buttons
  function toggleIngredients(showAll) {
    isShowingAll = showAll;
    renderIngredients(isShowingAll ? ingredients.length : initialLimit, ingredientList);
    showMoreButton.classList.toggle("hidden", isShowingAll); // Hide "Show More" if all items are shown
    showLessButton.classList.toggle("hidden", !isShowingAll); // Hide "Show Less" if only a few items are shown
  }

  // Event listeners for the buttons
  showMoreButton.onclick = () => toggleIngredients(true);
  showLessButton.onclick = () => toggleIngredients(false);

  // Render initial ingredients
  renderIngredients(initialLimit, ingredientList);

  // Update the active button style
  const buttons = document.querySelectorAll('.category-btn');
  buttons.forEach(btn => btn.classList.remove('library_btn_active'));
  button.classList.add('library_btn_active');

  // Open mobile view with all ingredients
mobileViewButton.onclick = () => {
  renderIngredients(ingredients.length, mobileIngredientList); // Render all in mobile modal
  categoryView.classList.remove('hidden');
};
}


// Load the default section on page load
window.onload = function() {
  const defaultLetter = '{{ settings.default_library_button }}' || 'A';
  const defaultButton = document.querySelector(`[data-letter="${defaultLetter}"]`);
  if (defaultButton) {
    defaultButton.classList.add('library_btn_active');
    showIngredients(defaultLetter, defaultButton);
  }

    // Add click listener to the back button for closing the popup
  const backButton = document.getElementById('back-button');
  const categoryView = document.getElementById('category-view');
  backButton.onclick = () => closeModal('category-view');
};

function openModal(ingredient) {
  const modal = document.getElementById('popup-modal');
  document.getElementById('modal-title').innerText = ingredient.name || "";
  document.getElementById('modal-description').innerText = ingredient.modal?.Description || "No description available";
  document.getElementById('modal-image').src = ingredient.modal?.modalimg || "";
  document.getElementById('modal-found-inside').innerText = ingredient.modal?.origin || "Not specified";
  document.getElementById('modal-what-it-contains').innerText = ingredient.modal?.contains || "Not specified";
  document.getElementById('modal-why-we-chose-it').innerText = ingredient.modal?.choose || "Not specified";
  document.getElementById('modal-type-of-ingredient').innerText = ingredient.modal?.typeOfIngredient || "Unknown";
const formulaElements = document.querySelectorAll('.data-found-inside-the-formula');

formulaElements.forEach(el => {
  const text = ingredient.modal?.formula || "Not specified";
  const url = ingredient.modal?.link;

  if (!url) {
    el.innerText = text;
    return;
  }

  el.innerHTML = `
    <a href="${url}"
       class="underline text-[#1E00FF]"
       rel="noopener">
      ${text}
    </a>
  `;
});

  // Show modal
  modal.classList.remove('hidden');
    freezeBackground();

}

