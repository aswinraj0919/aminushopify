            <p id="modal-found-inside" class="sm:mb-6 mb-3 sm:text-[16px] text-[14px] font-[300]">Sub-Saharan Region</p>
            <h2 class="sm:text-[24px] text-[18px] font-[600] sm:mb-1 mb-2">Type of ingredient</h2>
