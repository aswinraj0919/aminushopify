<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.core.min.css"
>
<style>
    body.popup-open {
    overflow: hidden;
    height: 100vh;
  }
      /* 🔹 Unique Wrapper */
      .unique-key-ingredients .glide__track {
        overflow: hidden;
        padding: 0 1rem;
      }

      .unique-key-ingredients .glide__slides {
        display: flex;
        align-items: stretch;
      }

      .unique-key-ingredients .glide__slide {
        list-style: none !important;
      }

      .unique-key-ingredients .glide__slide > div {
        margin: 0 auto;
        background: white;
        width: 260px;
      }

      .unique-key-ingredients img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        border-radius: 4px;
        border: 0.4px solid black;
      }

      /* 🔹 Arrows Styling */
      .unique-key-ingredients .glide__arrows-ingredients {
        position: absolute;
        top: 45%;
        width: 100%;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
      }

      .unique-key-ingredients .glide__arrow {
        pointer-events: auto;
        background: white;
        border: 1px solid black;
        width: 30px;
        height: 30px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s ease;
      }

      .unique-key-ingredients .glide__arrow:hover {
        background-color: #f3f3f3;
      }


      /* 🔹 Modal Scroll */
      .unique-key-ingredients #my-modal2 .relative {
        max-height: 80vh;
      }

      /* 🔹 Hide Section on Mobile */
      @media (max-width: 767px) {
        .hide-on-mobile {
          display: none !important;
        }
      }
    /* Popup Styles */
      .popup {
        background: rgba(0, 0, 0, 0.5);
        position: fixed;
        display: none;
  z-index: 2147483647;
        height: 100%;
        width: 100%;
        left: 0;
        top: 0;
        justify-content: center;
        align-items: center;
      }

      .popup-content {
        position: relative;
        background: #fff;
        border-radius: 10px;
        width: 70%;
        max-width: 750px;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
      }



      @media (max-width: 768px) {
        .popup-content {
          width: 90%;
        }
      }
  .custom-border-ing  {

    {% if product.metafields.custom.show_ingredient_top_border != false %}
      border-top: 1px solid #000000;
    {% else %}
      border-top: 1px solid #000000;
    {% endif %}

    {% if product.metafields.custom.show_ingredient_bottom_border == true %}
      border-bottom: 1px solid #000000;
    {% else %}
      border-bottom: none;
    {% endif %}
  }

  /* Mobile */
  @media (max-width: 640px) {
    .custom-border-ing {

      {% if product.metafields.custom.show_ingredient_top_border != false %}
        border-top: 0.5px solid #000000;
      {% else %}
        border-top: 0.5px solid #000000;
      {% endif %}

      {% if product.metafields.custom.show_ingredient_bottom_border == true %}
        border-bottom: 0.5px solid #000000;
      {% else %}
        border-bottom: none;
      {% endif %}

    }
  }
</style>

<section
  class="bg-white key-ingredients-section unique-key-ingredients hide-on-mobile custom-border-ing"
>
  <div class="ug-container">
    <h2
      class="sm:text-[40px] text-[32px] font-[600] sm:leading-[40px] leading-[42px] sm:mb-8 mb-4 ml-[5px]"
    >
      {{ product.metafields.custom.key_ingredients_title }}
    </h2>
    <p
      class="sm:mb-12 mb-6 sm:text-[18px] text-[14px] font-[400] leading-[19px]"
    >
      {{ product.metafields.custom.key_ingredients_subtitle }}
    </p>

    <div class="relative glide-key-ingredients">
      <div class="glide__track md:mx-12" data-glide-el="track">
        <ul class="glide__slides">
          {% for block in product.metafields.custom.key_ingredients_carousel.value %}
            <li class="glide__slide">
              <div class="md:w-[300px] w-[160px]">
                <img
                  src="{{ block.key_ingredients_cover_image | file_url }}"
                  alt="{{ block.key_ingredients_carousel_title }}"
                  class="mb-4 rounded-[4px] md:h-[300px] h-[160px] md:w-[300px] w-[160px] object-cover"
                  style="border: 0.4px solid black"
                >
                <h3
                  class="text-[24px] font-[500] leading-[30px] !text-[#000000]"
                >
                  {{ block.key_ingredients_carousel_title }}
                </h3>
                <p
                  class="text-[18px] font-[400] leading-[26px] mt-3 !text-[#000000]"
                >
                  {{ block.key_ingredients_carousel_description }}
                </p>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Arrows -->
      <div
        class="glide__arrows-ingredients"
        data-glide-el="controls"
      >
        <button
          class="glide__arrow glide__arrow--prev"
          data-glide-dir="<"
          id="carousel-prev"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        <button
          class="glide__arrow glide__arrow--next"
          data-glide-dir=">"
          id="carousel-next"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Popup Trigger Button -->
    <div class="text-center mt-12">
      <a
        class="popup-trigger text-white hover:text-black py-3 px-20 border-[1px] rounded-[4px] border-black sm:text-[20px] text-[14px] font-[500] leading-[19px] sm:w-fit w-full cursor-pointer"
        data-target="#popup-ingredients-global"
        style="
          --brand-black: {{ product.metafields.custom.brand_black_color | default: '#000000' }};
          --primary-color: {{ product.metafields.custom.primary_brand_color | default: '#F9EBDA' }};
          background-color: var(--brand-black);
        "
        onmouseover="this.style.backgroundColor='var(--primary-color)'"
        onmouseout="this.style.backgroundColor='var(--brand-black)'"
      >
        Full Ingredient List
      </a>
    </div>
  </div>
</section>
<!-- Popup -->
<div id="popup-ingredients-global" class="popup">
  <div class="popup-content">
    <!-- Sticky Close Button -->
    <div class="sticky top-0 right-0 bg-white flex justify-end z-20">
      <button
        class="popup-close bg-black text-white w-[30px] h-[30px] flex items-center justify-center rounded-full hover:bg-gray-700 m-2"
        id="closeModal"
      >
        ✕
      </button>
    </div>

    {% comment %}
      <button
        class="popup-close"
        id="closeModal"
      >
        ✕
      </button>
    {% endcomment %}
    <div class="popup-text px-6 py-3">
      {{ product.metafields.custom.key_ingredients_full_ingredient_list_text | metafield_tag }}
    </div>
  </div>
</div>
<script src="https://cdn.tailwindcss.com"></script>
<script defer src="https://cdn.jsdelivr.net/npm/flowbite@2.5.1/dist/flowbite.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/glide.min.js"></script>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
      new Glide('.unique-key-ingredients .glide-key-ingredients', {
        type: 'carousel',
        perView: 4,
        gap: 10,
        rewind: true,
        animationDuration: 400,
        breakpoints: {
          900: { perView: 2.3, gap: 2 },
          640: { perView: 1.4, gap: 2 },
        },
      }).mount();
    });

    $(document).ready(function () {
      /* -----------------------------
         POPUP LOGIC
      ----------------------------- */
      function openPopup(popup) {
    const scrollY = window.scrollY;
    $('body')
      .addClass('popup-open')
      .css({
        position: 'fixed',
        top: -scrollY + 'px',
        width: '100%',
      });

    $(popup).css('display', 'flex');
  }
      function closePopup(popup) {
    const scrollY = $('body').css('top');
    $('body').removeClass('popup-open').css({
      position: '',
      top: '',
      width: '',
    });

    window.scrollTo(0, parseInt(scrollY || '0') * -1);
    $(popup).hide();
  }

      // Open popup on trigger click
      $('.popup-trigger').on('click', function () {
        const target = $(this).data('target');
        openPopup($(target));
      });

      // Close popup on ✕ click
      $(document).on('click', '.popup-close', function () {
        closePopup($(this).closest('.popup'));
      });
    });
</script>