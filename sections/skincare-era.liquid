<!-- sections/skincare-era.liquid -->
<div class="skincare-era-wrapper">
  <div class="md:text-center ug-container">
    <h2 class="era-heading">{{ section.settings.heading }}</h2>

    <!-- Desktop Grid -->
    <div class="era-grid desktop-era-grid">
  {% for block in section.blocks %}
    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}" class="era-item-link">
    {% endif %}

    <div class="era-item {% if forloop.first %}active{% endif %}">
      {% if block.settings.icon != blank %}
        <img
          src="{{ block.settings.icon | image_url }}"
          alt="{{ block.settings.text }}"
          class="era-icon"
          loading="lazy"
        >
      {% endif %}
      <p class="era-text">{{ block.settings.text }}</p>
    </div>

    {% if block.settings.link != blank %}
      </a>
    {% endif %}
  {% endfor %}
</div>

    <!-- Mobile Slider -->
    <div class="era-slider mobile-era-slider">
      <div class="era-slider-container">
        {% for block in section.blocks %}
          <div class="era-slide">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="era-item-link">
            {% endif %}

            <div class="era-item {% if forloop.first %}active{% endif %}">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url }}"
                  alt="{{ block.settings.text }}"
                  class="era-icon"
                  loading="lazy"
                >
              {% endif %}
              <p class="era-text">{{ block.settings.text }}</p>
            </div>

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Desktop + Mobile dono ke items select karo
    const eraItems = document.querySelectorAll(".era-item");

    eraItems.forEach(item => {
      item.addEventListener("click", function (e) {
        // Link ke saath conflict na ho isliye
        e.stopPropagation();

        // Sabse active hatao
        eraItems.forEach(i => i.classList.remove("active"));

        // Clicked item active
        this.classList.add("active");
      });
    });
  });
</script>

<style>
    .skincare-era-wrapper {
      background: #F1F1EF;
    }

    .era-heading {
      font-size: 42px;
      font-weight: 700;
      margin-bottom: 50px;
      font-family: inherit;
    }

    /* Desktop Grid */
    .desktop-era-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 50px;
      justify-items: center;
    }

    .mobile-era-slider {
      display: none;
    }

    /* Era item base */
.era-item {
  position: relative;
  text-align: center;
  z-index: 1;
}

/* Circle background (default hidden) */
.era-item::after {
  content: '';
  position: absolute;
  width: 100px;
  height: 100px;
  background: #FFFFFF;
  border: 0.3px solid #D25A3C;
  box-shadow: 0px 12px 10px #e9bfc045;
  border-radius: 50%;
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%) scale(0);
  transition: all 0.3s ease;
  z-index: -1;
  opacity: 0;
}

/* Hover & Active state */
.era-item:hover::after,
.era-item.active::after {
  width: 140px;
  height: 140px;
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}


    .era-icon {
      width: 120px;
      height: 120px;
      margin-bottom: 10px;
      object-fit: contain;
    }

    .era-text {
      font-size: 18px;
      font-weight: 600;
      font-family: inherit;
      margin: 0;
    }

    /* Clickable wrapper */
    .era-item-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    /* Mobile Slider Styles */
    @media screen and (max-width: 768px) {
      .desktop-era-grid {
        display: none;
      }

      .mobile-era-slider {
        display: block;
      }

      .era-slider-container {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 30px;
        padding: 10px 16px 20px; 
       margin: 0; 
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
         justify-content: flex-start;
      }

      .era-slider-container::-webkit-scrollbar {
        display: none;
      }

      .era-slide {
        flex: 0 0 calc(40% - 30px);
        min-width: calc(40% - 15px);
        max-width: calc(40% - 15px);
        scroll-snap-align: start;
      }

      .era-heading {
        font-size: 32px;
        margin-bottom: 30px;
        text-align: left;
      }

      .era-icon {
        width: 100px;
        height: 100px;
      }

      .era-text {
        font-size: 16px;
      }
      .era-item::after {
    width: 90px;
    height: 90px;
  }

  .era-item:hover::after,
  .era-item.active::after {
    width: 95px;
        height: 95px;
  }
    }

    /* Small Mobile */
    @media screen and (max-width: 600px) {
      .era-slide {
      flex: 0 0 calc(40% - 10px);
      min-width: calc(40% - 10px);
      max-width: calc(40% - 10px);
      scroll-snap-align: start;
    }
      .era-slider-container {
        gap: 20px;
      }

      .era-icon {
        width: 90px;
        height: 90px;
      }

      .era-text {
        font-size: 14px;
      }
    }

    /* Extra Small Mobile */
    @media screen and (max-width: 360px) {
      .era-slide {
      flex: 0 0 calc(40% - 5px);
      min-width: calc(40% - 5px);
      max-width: calc(40% - 5px);
      scroll-snap-align: start;
    }

      .era-slider-container {
        gap: 20px;
      }

      .era-icon {
        width: 80px;
        height: 80px;
      }
    }
</style>

{% schema %}
{
  "name": "Skincare Era",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Build Your Skincare Era :))"
    }
  ],
  "blocks": [
    {
      "type": "era",
      "name": "Era Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Upload Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "for clear era"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Item Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skincare Era",
      "blocks": [
        { "type": "era", "settings": { "text": "for clear era" } },
        { "type": "era", "settings": { "text": "for bright era" } },
        { "type": "era", "settings": { "text": "for timeless era" } },
        { "type": "era", "settings": { "text": "for hydration era" } },
        { "type": "era", "settings": { "text": "for barrier repair era" } },
        { "type": "era", "settings": { "text": "for smooth era" } },
        { "type": "era", "settings": { "text": "for every(day) era" } },
        { "type": "era", "settings": { "text": "for detox era" } }
      ]
    }
  ]
}
{% endschema %}








