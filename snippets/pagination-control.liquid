
{% if paginate.pages > 1 %}
  <div
    class="pagination"
    style="display: flex; align-items: center; justify-content: center; gap: px; margin: 40px 0; padding: 10px 0;"
  >
    {% if paginate.previous %}
      <a
        class="pagination__prev pagination__link"
        href="{{ paginate.previous.url }}"
        style="color: #689fff !important; text-decoration: none; font-size: 12px;"
        onmouseover="this.style.backgroundColor='#f0f7ff'"
        onmouseout="this.style.backgroundColor='transparent'"
      >
        &laquo; {{ 'general.pagination.previous' | t }}
      </a>
      <span class="pagination__sep" style="color: #000000;">&middot;</span>
    {% endif %}

    {% for part in paginate.parts %}
      {% if paginate.current_page == 1 and part.title == 1 %}
        {% assign is_page_one = true %}
      {% else %}
        {% assign is_page_one = false %}
      {% endif %}
      
      <span
        class="pagination__number{% if paginate.current_page == part.title %} underline{% endif %}"
        style="{% if is_page_one %}color: #000000 !important; font-size: 16px; font-weight: bold;{% elsif paginate.current_page == part.title %}color: #000000 !important; font-size: 12px;font-weight: bold;{% else %}font-size: 12px;{% endif %}"
      >
        {%- if part.is_link -%}
          <a 
            class="pagination__link" 
            href="{{ part.url }}" 
            style="color: {% if is_page_one %}#000000{% else %}#689fff{% endif %} !important; text-decoration: none; font-size: inherit;"
          >
            {{- part.title -}}
          </a>
        {%- else -%}
          {{- part.title -}}
        {%- endif -%}
      </span>
    {% endfor %}

    {% if paginate.next %}
      <span class="pagination__sep" style="color: #000000;">&middot;</span>
      <a
        class="pagination__next pagination__link"
        href="{{ paginate.next.url }}"
        style="color: #689fff !important; text-decoration: none; font-size: 12px;"
        onmouseover="this.style.backgroundColor='#f0f7ff'"
        onmouseout="this.style.backgroundColor='transparent'"
      >
        {{- 'general.pagination.next' | t }} &raquo;
      </a>
    {% endif %}
  </div>
{% endif %}