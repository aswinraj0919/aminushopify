      "blocks": {
        "how_to_use_NDGH6m": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Longevity_Serum_d0ad7348-5cf6-4944-b083-18288edd68b4.jpg",
            "title": "<p><strong>STEP 1 - LONGEVITY SERUM</strong></p>",
            "description": "<p><strong><br>USE</strong>: in the AM as your daily protector —<br>shielding your skin from environmental stress, pollution, and premature aging.<br><br><strong>HOW:</strong> Apply 2–3 drops on clean, dry skin after cleansing. Let it absorb fully<br>before following up with moisturizer and sunscreen.</p>"
          }
        },
        "how_to_use_dtibGz": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Copper_Peptide_Serum.jpg",
            "title": "<p><strong>STEP 2 - COPPER PEPTIDE SERUM</strong></p>",
            "description": "<p><strong><br>USE</strong>: in the PM, 4–5 times a week, to support skin repair & collagen production.<br><br><strong>HOW</strong>: Apply 2–3 drops on clean skin after cleansing. Wait 30–60 seconds before<br>layering other serums or creams.<br>Follow up with sunscreen if applied during the day.</p>"
          }
        },
        "how_to_use_A9Cd4G": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Overnight_Peel_20739447-8f2c-467a-9107-a1acb4590df6.jpg",
            "title": "<p><strong>STEP 3 - OVERNIGHT PEEL</strong></p>",
            "description": "<p><strong><br>USE: </strong>2–3 times a week at night (on alternate days when you’re not using the Copper Peptide Serum) to gently exfoliate, brighten,<br>and smooth your skin.<br><br><strong>HOW:</strong> Apply 1–2 drops on clean skin, apply moisturiser and leave on overnight. Follow up with sunscreen during the day.</p>"
          }
        },
        "how_to_use_YEjUFF": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Radiance_Face_Oil_fe1395cf-7862-424b-95e6-6dc9f9bc9241.jpg",
            "title": "<p><strong>STEP 4 - RADIANCE FACE OIL</strong></p>",
            "description": "<p><strong><br>USE</strong>: as and when needed to deeply nourish your skin and give it a soft, non-sticky glow.<br><br><strong>HOW</strong>: Massage 2–3 drops onto slightly damp skin as the final step in your routine.<br>Follow up with sunscreen during the day.</p><p><strong>TIP</strong>: It also works beautifully under makeup — mix 1–2 drops with your foundation for a dewy, seamless finish.</p>"
          }
        },
        "pro_tips_qq6Nfi": {
          "type": "pro_tips",
          "settings": {
            "pro_tips_image": "shopify://shop_images/DOU_Icon_2_6bcdcc04-4ed6-40d2-b7f2-80841de0dfe2.png",
            "description": "Do not use strong antioxidants, AHA's, direct acids/ L-ascorbic acid / Ethylated L-Ascorbic Acid in the same routine. For eg - Use Longevity Serum in the AM & Copper Peptide Serum OR Overnight Peel in the PM! The Radiance Face Oil can be used as needed."
          }
        },
        "pro_tips_44GEXY": {
          "type": "pro_tips",
          "settings": {
            "pro_tips_image": "shopify://shop_images/DOU_Icon_4_2ec110ff-1e2f-4227-895d-c3b9e0eb4aba.png",
            "description": "Gently tapping with your fingertips after applying the products on your face for faster absorption. You can even use the face oil for a luxurious face massage!"
          }
        },
        "pro_tips_g9AhLG": {
          "type": "pro_tips",
          "settings": {
