        },
        "why_you_need_this_dgb8hi": {
          "type": "why_you_need_this",
          "settings": {
            "title": "All Your Skin Needs, In One Set",
            "description": "This ritual supports your skin barrier, energizes tired skin, and improves tone, texture, & resilience. It helps with dryness, dark spots, dullness, puffiness, and most common skin concerns. From brightening and exfoliating to firming & healing, this is your one-stop skincare set for protection, repair, and better aging."
          }
        },
        "why_you_need_this_TQDQ8G": {
          "type": "why_you_need_this",
          "settings": {
            "title": "Powered by 40+ Cutting-Edge Actives,",
            "description": "From around the world, this set brings to you the best of clean beauty. While niacinamide, rutin, vitamin C, and gallic acid defend against pollution & oxidative stress,  hyaluronic acid, plant ceramides, & squalane hydrate & strengthen the skin barrier. Copper peptides, silanol, & ectoin calm inflammation and promote healing. Slow-release AHAs, rainbow algae, & a patented brightening peptide exfoliate and even skin tone for a visibly healthier, more radiant complexion."
          }
        },
        "why_you_need_this_z6nbfQ": {
          "type": "why_you_need_this",
          "settings": {
            "title": "Discovery & Travel-Friendly!",
            "description": "Trying Aminu for the first time? Or looking for a portable skincare routine that doesn’t compromise on results? This compact set is ideal for both. It fits into any bag, works across all skin types, and delivers targeted care — anytime, anywhere."
          }
        },
