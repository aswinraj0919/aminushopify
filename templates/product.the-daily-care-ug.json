        "save_text": "SAVE 13%",
        "free_text": "<p><strong>+</strong> <strong>Get A Carry-All Pouch (worth ₹1,250.00) Free!</strong></p><p><strong>+ 5% off on prepay</strong></p><p><em><strong>+ </strong></em><strong>an extra 10% off with code HELLO10 </strong>(applicable on your first order)</p>"
      }
    },
    "odyssey_trunk_accordion": {
      "type": "odyssey_trunk_accordion",
      "blocks": {
        "how_to_use_JttLtq": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Step_1_-_Cleanse.jpg",
            "title": "<p><strong>STEP 1: </strong>Cleanse before you begin!</p>",
            "description": "<p><strong>HOW: </strong>Take a pump of product, gently massage onto wet skin, rinse off with water & pat dry. This will provide your skin with a clean slate to absorb the products well!<br/><br/><strong>WHERE: </strong>Face & Neck<br/><br/><strong>WHEN: </strong>AM and PM</p>"
          }
        },
        "how_to_use_NDGH6m": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/eye_serum_step_2.jpg",
            "title": "<p><strong>STEP 2:</strong> Eye Serum</p>",
            "description": "<p><strong>HOW:</strong> Gently tap <strong>one drop</strong> of product from the inner corner along the under-eye & up to the brow bone. Repeat for the other eye.<br/><br/><strong>WHERE:</strong> Swipe once under the eye, then above the brow, & apply the remaining serum on the eyelid for all-around care.<br/><br/><strong>WHEN:</strong> AM and/or PM, after cleanser but before serum & moisturizer.</p>"
          }
        },
        "how_to_use_dtibGz": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Copper_Peptide_Serum_1.webp",
            "title": "<p><strong>STEP 3:</strong> Copper Peptide Serum</p>",
            "description": "<p><strong>&lt;strong&gt; HOW &lt;/strong&gt;:</strong> Apply 2-3 drops evenly on clean skin, with your fingertips. Avoid touching the glass dropper directly to your skin.<br/><br/><strong>WHEN: </strong>AM & PM<br/><br/><strong>WHERE: </strong>Face & Neck</p>"
          }
        },
        "how_to_use_NFkfq4": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/How_To_Use_Moist.jpg",
            "title": "<p><strong>STEP 4:</strong> Seal in the goodness with a moisturiser!</p>",
            "description": "<p><strong>HOW: </strong>Warm up one pump of cream between your fingertips and massage it in using light pressure. Your skin is sure to feel happy and hydrated post this ritual!<br/><br/><strong>WHERE: </strong>Face & Neck<br/><br/><strong>WHEN: </strong>AM and PM</p>"
          }
        },
        "how_to_use_hhL8pz": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/Step_5_-_sunscreen.jpg",
            "title": "<p><strong>STEP 5:</strong> Sun protection</p>",
            "description": "<p><strong>HOW: </strong>To make the most of your skincare ritual, always top it off with sunscreen! Take 3-4 drops of your SPF and apply evenly over your face.<br/><br/><strong>WHEN: </strong>AM<br/><br/><strong>WHERE: </strong>Face and Neck</p>"
          }
        },
        "pro_tips_qq6Nfi": {
          "type": "pro_tips",
          "settings": {
            "pro_tips_image": "shopify://shop_images/DOU_Icon_1_0dd79996-2900-441d-bd0c-ca83f636e4ba.png",
            "description": "Make this duo a regular part of your routine for best results & avoid tugging on the gentle skin!"
          }
        },
        "pro_tips_44GEXY": {
          "type": "pro_tips",
          "settings": {
            "pro_tips_image": "shopify://shop_images/DOU_Icon_2_a226c170-d592-4668-8376-fbf114bf549e.png",
            "description": "Consistency is key! Only with regular use will you be able to experience the true beauty of this set. As you continue to use the products, you will see how it helps treat visible signs of aging and also delays new signs from developing."
          }
        },
        "pro_tips_g9AhLG": {
          "type": "pro_tips",
          "settings": {
            "pro_tips_image": "shopify://shop_images/DOU_Icon_3_59393fb1-2d7a-4495-a48b-87409a424e1b.png",
            "description": "Regular use of the copper peptide serum, bio retinol cream, and eye serum supports healthier, more radiant skin over time. For makeup wearers, the copper peptide serum boosts hydration for a smooth finish, while the eye serum helps prevent caking around the eyes."
          }
        },
        "why_you_need_this_dgb8hi": {
          "type": "why_you_need_this",
          "settings": {
            "title": "Daily Care, For Real",
            "description": "The Copper Peptide Serum works to rebuild and fortify your skin, increasing its natural resilience while helping to smooth fine lines and boost elasticity. The Eye Serum targets dark circles, puffiness, & fine lines around the eyes—giving you that fresh, awake look even after long days."
          }
        },
        "why_you_need_this_TQDQ8G": {
          "type": "why_you_need_this",
          "settings": {
            "title": "Prevents as much as it fixes",
            "description": "This duo doesn’t just address what you see—it actively prevents future damage. The Copper Peptide Serum stimulates collagen to protect against aging & environmental stress, while the Eye Serum nourishes the delicate skin around your eyes, keeping it firm & protected."
          }
        },
        "why_you_need_this_z6nbfQ": {
          "type": "why_you_need_this",
          "settings": {
            "title": "Full-Face Care That Lasts",
            "description": "We’re talking about a healthy, balanced complexion. The Copper Peptide Serum improves skin texture & reduces dullness, while the Eye Serum refreshes & revitalizes tired eyes. Together, they maintain smooth, glowing skin that feels firm & resilient all day long."
          }
        },
        "product_details_n6ERB7": {
