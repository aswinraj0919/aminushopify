    "about-us-hero-section-import": {
      "type": "about-us-hero-section",
      "settings": {
        "title": "About Aminu!",
        "subtitle": "pronounced as uh-mee-nu.",
        "description": "Aminu brings together the best of science and art to give you the healthiest skin\npossible. We're inspired by everything, from the nutritional richness of superfoods to the captivating intricacies of microbiology, and material sciences to art and culture. \nOur goal is to make skincare easy and effective for you, no matter your level of expertise.<br>\nWith Aminu, you get a individual skincare expert in every bottle! We carefully blend\nmultiple advanced ingredients and traditional wisdom to give you visibly healthy,\nradiant skin. In addition, our artful packaging and unique experiences make you feel healthy & confident, every time you use Aminu!"
      }
    },
    "about_us_image_with_text_f6UQG9": {
      "type": "about-us-image-with-text",
      "name": "About Us Image With Text",
      "settings": {
        "section_title": "The Journey Behind Aminu",
        "text": "<p>At Aminu, our journey is deeply rooted in personal experiences and the profound understanding of the intricacies of skin health. Every product we formulate carries a story - a story of compassion, confidence, and a promise to deliver visibly healthy skin</p>",
        "about_image": "shopify://shop_images/about_aminu_a6994360-6989-4d11-922a-2e304b333abb.jpg",
        "image_position": "right"
      }
    },
    "about_us_image_with_text_DqU4NE": {
      "type": "about-us-image-with-text",
      "name": "About Us Image With Text",
      "settings": {
        "section_title": "Every Number Has a Story",
        "text": "<ul><li>10+ Innovations & Technologies – Targeted delivery for optimal skin results.</li><li>40+ Countries of Origin – Finest ingredients from top labs worldwide.</li><li>150+ Editorial Features – Award-winning solutions trusted by leading publications.</li><li>250+ High-Performing Ingredients – Clinically proven actives for healthy skin.</li><li>1,000+ Aestheticians Trained – Experts delivering the signature “Aminu Touch.”</li><li>1,350+ Harsh Ingredients Avoided – Gentle on skin and planet.</li><li>45,000+ Treatments Delivered – Restoring balance and radiance, one treatment at a time.</li></ul>",
        "about_image": "shopify://shop_images/Double_cleansing_duo_b068d344-9c24-454d-80a5-b2f9c2821809.jpg",
        "image_position": "left"
      }
    },
    "about_us_image_with_text_imyLq6": {
      "type": "about-us-image-with-text",
      "name": "About Us Image With Text",
      "settings": {
        "section_title": "Skin solutions that truly understand",
        "text": "<ul><li>what your skin needs. </li><li>what it needs now. what it will need tomorrow. </li><li>what it needs season to season. what it needs in the morning, </li><li>what it needs at night. </li><li>what it needs when things go wrong and .</li><li>when it needs special care. when it needs something for no reason at all. </li></ul>",
        "about_image": "shopify://shop_images/glow_essentials.jpg",
        "image_position": "right"
      }
    },
    "about_us_our_founders_KbThtm": {
      "type": "about-us-our-founders",
      "blocks": {
        "founder_ffrRdL": {
          "type": "founder",
          "settings": {
            "founder_image": "shopify://shop_images/prachi_bhandari.webp",
            "founder_name": "Prachi Bhandari",
            "founder_bio": "<p>Combining my passion for art, science, and skincare, I have created a range of products that promote radiant skin health. My journey began when I helped my father recover from a rare infection, inspiring me to open a clinical spa focused on holistic skin treatments.<br/>After 8 years of caring for clients' skin needs, I decided to take my passion to the next level by developing skincare solutions that feature the best ingredients from labs across the world and award-winning innovations. This unwavering dedication sets Aminu apart, and you can experience it in every bottle and jar we offer!</p>"
          }
        },
        "founder_xh7P34": {
          "type": "founder",
          "settings": {
            "founder_image": "shopify://shop_images/aman_mohanta.webp",
            "founder_name": "Aman Mohunta",
            "founder_bio": "<p>Educated at IIT Kanpur and University of Chicago Booth School of Business, Aman has worked as a macro researcher at Nomura and Ministry of Finance, Government of India and macro trader at Bank of America. His pursuit to make an impact in the real world took him to Tranzmute where he scaled young companies.<br/>At Aminu, his cumulative experiences and his global network has inculcated this unique ability to build and scale an organisation using the 'first principles' approach. You will find this first principles approach in everything we do at Aminu.</p>"
          }
        },
        "founder_YcCDjA": {
          "type": "founder",
          "settings": {
            "founder_image": "shopify://shop_images/Sanjay_joshi.webp",
            "founder_name": "Sanjay Doshi",
            "founder_bio": "<p>A seasoned businessman with thirty years of experience in navigating the labyrinth called Indian manufacturing<br/>sector, Sanjay swears by the mantra \"never say never\". He is also our in-house mentor that every 30 something start up founder needs!</p>"
          }
        }
      },
