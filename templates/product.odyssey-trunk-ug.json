    "odyssey_trunk_accordion": {
      "type": "odyssey_trunk_accordion",
      "blocks": {
        "how_to_use_NDGH6m": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/melting_balm_step_1.jpg",
            "title": "<p><strong>STEP 1</strong></p>",
            "description": "<p><strong>HOW:</strong> Massage a dime-size amount on dry skin, then massage with wet fingertips to transform the balm into creamy milk, then rinse & gently pat dry. Finish with serum & moisturizer.<br/><strong>WHERE:</strong> Entire face, gently with no pressure.<br/><strong>WHEN:</strong> PM.</p>"
          }
        },
        "how_to_use_dtibGz": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/eye_serum_step_2.jpg",
            "title": "<p><strong>STEP 2</strong></p>",
            "description": "<p><strong>HOW:</strong> Gently tap one drop of product from the inner corner along the under-eye & up to the brow bone. Repeat for the other eye.<br/><strong>WHERE:</strong> Swipe once under the eye, then above the brow, & apply the remaining serum on the eyelid for all-around care.<br/><strong>WHEN:</strong> AM and/or PM, after cleanser but before moisturizer. Follow it up with SPF in the day!</p>"
          }
        },
        "how_to_use_YEjUFF": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/radiance_step_3.jpg",
            "title": "<p><strong>STEP 3</strong></p>",
            "description": "<p><strong>HOW:</strong> Gently press 2-3 drops into clean skin & allow it to absorb for two minutes. Apply SPF after, in the daytime.<br/><strong>WHERE:</strong> Entire face & neck.<br/><strong>WHEN:</strong> AM and/or PM after cleansing (and masking or exfoliating). Can be used as an alternative to moisturizer or mixed with it.</p>"
          }
        },
        "how_to_use_A9Cd4G": {
          "type": "how_to_use",
          "settings": {
            "image": "shopify://shop_images/vit_c_step_4.jpg",
            "title": "<p><strong>STEP 4</strong></p>",
            "description": "<p><strong>How:</strong> Warm a few drops of oil in your palms & massage onto damp skin in circular motions.<br/><strong>Where:</strong> Entire body, not for the face!<br/><strong>When:</strong> Use daily, ideally after a shower!</p>"
          }
        },
